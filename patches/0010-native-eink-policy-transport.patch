+    Mutex::Autolock _l(mDisplayLock);
+    DisplayData& disp(mDisplayData[id]);
+    if (!disp.framebufferTarget) {
+        return NO_ERROR;
+    }
+
+    hwc_region_t& surfaceDamage = disp.framebufferTarget->surfaceDamage;
+
+    // INVALID_RECT is the upstream encoding of unknown damage. HWC 1.5 spells
+    // that as zero rects, meaning the whole layer must be refreshed.
+    if (damage.getBounds() == Rect::INVALID_RECT) {
+        disp.fbTargetDamageRegion.clear();
+        surfaceDamage.numRects = 0;
+        surfaceDamage.rects = NULL;
+        return NO_ERROR;
+    }
+
+    // An empty region genuinely means nothing changed on screen. HWC 1.5
+    // distinguishes that from unknown damage with a single empty rect, which
+    // matters here: reporting unknown damage on an idle frame would trigger a
+    // needless full-screen GC16 refresh.
+    if (damage.isEmpty()) {
+        disp.fbTargetDamageRegion.clear();
+        disp.fbTargetNoDamageRect.left = 0;
+        disp.fbTargetNoDamageRect.top = 0;
+        disp.fbTargetNoDamageRect.right = 0;
+        disp.fbTargetNoDamageRect.bottom = 0;
+        surfaceDamage.numRects = 1;
+        surfaceDamage.rects = &disp.fbTargetNoDamageRect;
+        return NO_ERROR;
+    }
+
+    // Keep a copy alive: the hwc_layer_1_t only stores a pointer into it and
+    // the HAL reads it during set().
+    disp.fbTargetDamageRegion = damage;
+    surfaceDamage.rects = reinterpret_cast<hwc_rect_t const*>(
+            disp.fbTargetDamageRegion.getArray(&surfaceDamage.numRects));
+    return NO_ERROR;
+}
