+status_t HWComposer::setFramebufferTargetDamage(int32_t id,
+        const Region& damage) {
+    if (uint32_t(id) > 31 || !mAllocatedDisplayIDs.hasBit(id)) {
+        return BAD_INDEX;
+    }
+    if (!mHwc || !hwcHasApiVersion(mHwc, HWC_DEVICE_API_VERSION_1_5)) {
+        return NO_ERROR;
+    }
