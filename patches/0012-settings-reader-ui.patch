index 0000000..b8e0c3a
--- /dev/null
+++ b/packages/apps/Settings/src/com/android/settings/ridi/RidiWifiSettingsActivity.java
@@ -0,0 +1,404 @@
+/*
+ * Copyright (C) 2026 E70Q10 Android port
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ */
+package com.android.settings.ridi;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.content.BroadcastReceiver;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.net.wifi.ScanResult;
+import android.net.wifi.WifiConfiguration;
+import android.net.wifi.WifiInfo;
+import android.net.wifi.WifiManager;
+import android.os.Bundle;
+import android.text.InputType;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.Window;
+import android.view.WindowManager;
+import android.widget.ArrayAdapter;
+import android.widget.EditText;
+import android.widget.ImageView;
+import android.widget.ListView;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import com.android.settings.R;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Static RIDI-style Wi-Fi screen backed by Android's normal WifiManager.
+ *
+ * It deliberately omits animated switches, expanding cards and live signal
+ * animations. Enterprise EAP configuration falls back to AOSP's complete
+ * editor; common open/WEP/WPA-PSK networks stay in this reader UI.
+ */
+public final class RidiWifiSettingsActivity extends Activity {
+    private WifiManager mWifi;
+    private TextView mState;
+    private TextView mToggle;
+    private TextView mListTitle;
+    private ListView mList;
+    private NetworkAdapter mAdapter;
+    private boolean mReceiverRegistered;
+
+    private final BroadcastReceiver mReceiver = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            final String action = intent.getAction();
+            if (WifiManager.WIFI_STATE_CHANGED_ACTION.equals(action)
+                    || WifiManager.SCAN_RESULTS_AVAILABLE_ACTION.equals(action)
+                    || WifiManager.NETWORK_STATE_CHANGED_ACTION.equals(action)) {
+                updateState();
+            }
+        }
+    };
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        RidiEinkRefresh.configure(getWindow().getDecorView());
+        setContentView(R.layout.ridi_wifi_settings);
+
+        mWifi = (WifiManager) getApplicationContext()
+                .getSystemService(Context.WIFI_SERVICE);
+        mState = findViewById(R.id.wifi_state);
+        mToggle = findViewById(R.id.wifi_toggle);
+        mListTitle = findViewById(R.id.wifi_list_title);
+        mList = findViewById(R.id.wifi_network_list);
+        mAdapter = new NetworkAdapter();
+        mList.setAdapter(mAdapter);
+
+        findViewById(R.id.wifi_back).setOnClickListener(v -> finish());
+        mToggle.setOnClickListener(v -> toggleWifi());
+        findViewById(R.id.wifi_refresh).setOnClickListener(v -> requestScan());
+        mList.setOnItemClickListener((parent, view, position, id) ->
+                selectNetwork(mAdapter.getItem(position)));
+    }
+
+    @Override
+    protected void onStart() {
+        super.onStart();
+        if (!mReceiverRegistered) {
+            final IntentFilter filter = new IntentFilter();
+            filter.addAction(WifiManager.WIFI_STATE_CHANGED_ACTION);
+            filter.addAction(WifiManager.SCAN_RESULTS_AVAILABLE_ACTION);
+            filter.addAction(WifiManager.NETWORK_STATE_CHANGED_ACTION);
+            registerReceiver(mReceiver, filter);
+            mReceiverRegistered = true;
+        }
+        updateState();
+        if (mWifi != null && mWifi.isWifiEnabled()) {
+            requestScan();
+        }
+    }
+
+    @Override
+    protected void onStop() {
+        if (mReceiverRegistered) {
+            unregisterReceiver(mReceiver);
+            mReceiverRegistered = false;
+        }
+        super.onStop();
+    }
+
+    @Override
+    public void finish() {
+        super.finish();
+        overridePendingTransition(0, 0);
+    }
+
+    private void toggleWifi() {
+        if (mWifi == null) {
+            return;
+        }
+        final boolean enable = !mWifi.isWifiEnabled();
+        if (!mWifi.setWifiEnabled(enable)) {
+            Toast.makeText(this, "Wi-Fi 상태를 변경할 수 없습니다.",
+                    Toast.LENGTH_SHORT).show();
+        }
+        mState.setText(enable ? "Wi-Fi 켜는 중" : "Wi-Fi 끄는 중");
+        mToggle.setText(enable ? "끄기" : "켜기");
+        RidiEinkRefresh.invalidate(mState);
+        RidiEinkRefresh.invalidate(mToggle);
+    }
+
+    private void requestScan() {
+        if (mWifi == null || !mWifi.isWifiEnabled()) {
+            updateState();
+            return;
+        }
+        mListTitle.setText("네트워크 검색 중");
+        RidiEinkRefresh.invalidate(mListTitle);
+        if (!mWifi.startScan()) {
+            mListTitle.setText("검색 요청 실패");
+            RidiEinkRefresh.invalidate(mListTitle);
+        }
+    }
+
+    private void updateState() {
+        if (mWifi == null) {
+            mState.setText("Wi-Fi를 사용할 수 없음");
+            mToggle.setText("켜기");
+            replaceNetworks(Collections.emptyList());
+            return;
+        }
+
+        switch (mWifi.getWifiState()) {
+            case WifiManager.WIFI_STATE_ENABLED:
+                mState.setText(connectedSsid());
+                mToggle.setText("끄기");
+                replaceNetworks(readNetworks());
+                break;
+            case WifiManager.WIFI_STATE_ENABLING:
+                mState.setText("Wi-Fi 켜는 중");
+                mToggle.setText("끄기");
+                break;
+            case WifiManager.WIFI_STATE_DISABLING:
+                mState.setText("Wi-Fi 끄는 중");
+                mToggle.setText("켜기");
+                break;
+            case WifiManager.WIFI_STATE_DISABLED:
+                mState.setText("Wi-Fi 꺼짐");
+                mToggle.setText("켜기");
+                replaceNetworks(Collections.emptyList());
+                break;
+            default:
+                mState.setText("Wi-Fi 준비 중");
+                mToggle.setText("켜기");
+                break;
+        }
+        RidiEinkRefresh.invalidate(mState);
+        RidiEinkRefresh.invalidate(mToggle);
+    }
+
+    private String connectedSsid() {
+        final WifiInfo info = mWifi.getConnectionInfo();
+        if (info == null || info.getNetworkId() < 0) {
+            return "Wi-Fi 켜짐";
+        }
+        return "연결됨 · " + unquote(info.getSSID());
+    }
+
+    private List<Network> readNetworks() {
+        final Map<String, ScanResult> strongest = new HashMap<>();
+        final List<ScanResult> results = mWifi.getScanResults();
+        if (results != null) {
+            for (ScanResult result : results) {
+                if (result == null || result.SSID == null || result.SSID.isEmpty()) {
+                    continue;
+                }
+                final ScanResult old = strongest.get(result.SSID);
+                if (old == null || result.level > old.level) {
+                    strongest.put(result.SSID, result);
+                }
+            }
+        }
+
+        final Map<String, Integer> saved = new HashMap<>();
+        final List<WifiConfiguration> configurations = mWifi.getConfiguredNetworks();
+        if (configurations != null) {
+            for (WifiConfiguration configuration : configurations) {
+                saved.put(unquote(configuration.SSID), configuration.networkId);
+            }
+        }
+
+        final WifiInfo info = mWifi.getConnectionInfo();
+        final String connected = info != null ? unquote(info.getSSID()) : "";
+        final List<Network> networks = new ArrayList<>();
+        for (ScanResult result : strongest.values()) {
+            networks.add(new Network(result, saved.get(result.SSID),
+                    result.SSID.equals(connected)));
+        }
+        Collections.sort(networks, Comparator
+                .comparing((Network network) -> !network.connected)
+                .thenComparing((Network network) -> -network.result.level)
+                .thenComparing(network -> network.result.SSID));
+        return networks;
+    }
+
+    private void replaceNetworks(List<Network> networks) {
+        mAdapter.replace(networks);
+        mListTitle.setText(networks.isEmpty()
+                ? (mWifi != null && mWifi.isWifiEnabled()
+                        ? "검색된 네트워크 없음" : "사용 가능한 네트워크")
+                : "사용 가능한 네트워크 · " + networks.size());
+        RidiEinkRefresh.invalidate(mListTitle);
+        RidiEinkRefresh.invalidate(mList);
+    }
+
+    private void selectNetwork(Network network) {
+        if (network == null) {
+            return;
+        }
+        if (network.networkId != null) {
+            connect(network.networkId);
+            return;
+        }
+        final String capabilities = network.result.capabilities != null
+                ? network.result.capabilities : "";
+        if (capabilities.contains("EAP")) {
+            openAospWifiSettings();
+        } else if (capabilities.contains("WEP") || capabilities.contains("PSK")) {
+            showPasswordDialog(network);
+        } else {
+            connectNew(network, null);
+        }
+    }
+
+    private void showPasswordDialog(Network network) {
+        final EditText password = new EditText(this);
+        password.setSingleLine(true);
+        password.setHint("비밀번호");
+        password.setInputType(InputType.TYPE_CLASS_TEXT
+                | InputType.TYPE_TEXT_VARIATION_PASSWORD);
+        password.setPadding(24, 12, 24, 12);
+
+        final AlertDialog dialog = new AlertDialog.Builder(this)
+                .setTitle(network.result.SSID)
+                .setView(password)
+                .setNegativeButton(android.R.string.cancel, null)
+                .setPositiveButton("연결", (ignored, which) ->
+                        connectNew(network, password.getText().toString()))
+                .create();
+        dialog.setOnShowListener(ignored -> makeWindowEinkSafe(dialog.getWindow()));
+        dialog.show();
+    }
+
+    private void connectNew(Network network, String password) {
+        final WifiConfiguration configuration = new WifiConfiguration();
+        configuration.SSID = quote(network.result.SSID);
+        final String capabilities = network.result.capabilities != null
+                ? network.result.capabilities : "";
+        if (capabilities.contains("WEP")) {
+            configuration.wepKeys[0] = quote(password);
+            configuration.wepTxKeyIndex = 0;
+            configuration.allowedKeyManagement.set(WifiConfiguration.KeyMgmt.NONE);
+            configuration.allowedAuthAlgorithms.set(WifiConfiguration.AuthAlgorithm.OPEN);
+            configuration.allowedAuthAlgorithms.set(WifiConfiguration.AuthAlgorithm.SHARED);
+        } else if (capabilities.contains("PSK")) {
+            configuration.allowedKeyManagement.set(WifiConfiguration.KeyMgmt.WPA_PSK);
+            configuration.preSharedKey = password != null
+                    && password.matches("[0-9A-Fa-f]{64}") ? password : quote(password);
+        } else {
+            configuration.allowedKeyManagement.set(WifiConfiguration.KeyMgmt.NONE);
+        }
+        final int networkId = mWifi.addNetwork(configuration);
+        if (networkId < 0) {
+            Toast.makeText(this, "네트워크를 저장할 수 없습니다.",
+                    Toast.LENGTH_SHORT).show();
+            return;
+        }
+        connect(networkId);
+    }
+
+    private void connect(int networkId) {
+        if (!mWifi.enableNetwork(networkId, true) || !mWifi.reconnect()) {
+            Toast.makeText(this, "네트워크 연결을 시작할 수 없습니다.",
+                    Toast.LENGTH_SHORT).show();
+            return;
+        }
+        mState.setText("연결 중");
+        RidiEinkRefresh.invalidate(mState);
+    }
+
+    private void openAospWifiSettings() {
+        final Intent intent = new Intent();
+        intent.setComponent(new ComponentName(getPackageName(),
+                "com.android.settings.Settings$WifiSettingsActivity"));
+        startActivity(intent);
+        overridePendingTransition(0, 0);
+    }
+
+    private void makeWindowEinkSafe(Window window) {
+        if (window == null) {
+            return;
+        }
+        window.setWindowAnimations(0);
+        window.setDimAmount(0f);
+        window.clearFlags(WindowManager.LayoutParams.FLAG_DIM_BEHIND);
+        window.getDecorView().setElevation(0f);
+        RidiEinkRefresh.configure(window.getDecorView());
+    }
+
+    private static String quote(String value) {
+        final String safe = value == null ? "" : value
+                .replace("\\", "\\\\").replace("\"", "\\\"");
+        return '"' + safe + '"';
+    }
+
+    private static String unquote(String value) {
+        if (value == null) {
+            return "";
+        }
+        return value.length() >= 2 && value.charAt(0) == '"'
+                && value.charAt(value.length() - 1) == '"'
+                ? value.substring(1, value.length() - 1) : value;
+    }
+
+    private static final class Network {
+        final ScanResult result;
+        final Integer networkId;
+        final boolean connected;
+
+        Network(ScanResult result, Integer networkId, boolean connected) {
+            this.result = result;
+            this.networkId = networkId;
+            this.connected = connected;
+        }
+    }
+
+    private final class NetworkAdapter extends ArrayAdapter<Network> {
+        NetworkAdapter() {
+            super(RidiWifiSettingsActivity.this, R.layout.ridi_setting_row);
+            setNotifyOnChange(false);
+        }
+
+        void replace(List<Network> networks) {
+            clear();
+            addAll(networks);
+            notifyDataSetChanged();
+        }
+
+        @Override
+        public View getView(int position, View convertView, ViewGroup parent) {
+            final View row = convertView != null ? convertView
+                    : LayoutInflater.from(getContext()).inflate(
+                            R.layout.ridi_setting_row, parent, false);
+            final Network network = getItem(position);
+            ((ImageView) row.findViewById(R.id.icon))
+                    .setImageResource(R.drawable.ridi_icon_wifi);
+            ((TextView) row.findViewById(R.id.title)).setText(network.result.SSID);
+            ((TextView) row.findViewById(R.id.summary)).setText(summary(network));
+            return row;
+        }
+
+        private String summary(Network network) {
+            final int level = WifiManager.calculateSignalLevel(network.result.level, 4);
+            final String security = network.result.capabilities.contains("EAP")
+                    ? "기업용" : network.result.capabilities.contains("PSK")
+                    ? "보안" : network.result.capabilities.contains("WEP")
+                    ? "WEP" : "개방";
+            if (network.connected) {
+                return "연결됨 · 신호 " + (level + 1) + "/4";
+            }
+            if (network.networkId != null) {
+                return "저장됨 · " + security + " · 신호 " + (level + 1) + "/4";
+            }
+            return security + " · 신호 " + (level + 1) + "/4";
+        }
+    }
+}
