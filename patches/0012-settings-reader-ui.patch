diff --git a/packages/apps/Settings/res/layout/ridi_frontlight_column.xml b/packages/apps/Settings/res/layout/ridi_frontlight_column.xml
new file mode 100644
index 0000000..808c7c0
--- /dev/null
+++ b/packages/apps/Settings/res/layout/ridi_frontlight_column.xml
@@ -0,0 +1,89 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Structure follows stock activity_brightness.xml and its 53dp controls. -->
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:gravity="center_horizontal"
+    android:orientation="vertical"
+    android:paddingStart="16dp"
+    android:paddingEnd="16dp"
+    android:paddingBottom="14dp">
+
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="48dp"
+        android:gravity="center"
+        android:orientation="horizontal">
+
+        <ImageView
+            android:id="@+id/control_icon"
+            android:layout_width="40dp"
+            android:layout_height="40dp"
+            android:contentDescription="@null" />
+
+        <TextView
+            android:id="@+id/control_title"
+            android:layout_width="wrap_content"
+            android:layout_height="match_parent"
+            android:drawablePadding="7dp"
+            android:gravity="center_vertical"
+            android:textColor="#ff000000"
+            android:textSize="18sp"
+            android:textStyle="bold" />
+    </LinearLayout>
+
+    <TextView
+        android:id="@+id/high_label"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:layout_marginTop="10dp"
+        android:gravity="center"
+        android:textColor="#ff666666"
+        android:textSize="14sp" />
+
+    <ImageButton
+        android:id="@+id/increase"
+        android:layout_width="53dp"
+        android:layout_height="53dp"
+        android:layout_marginTop="10dp"
+        android:background="@drawable/ridi_brightness_button"
+        android:contentDescription="@null"
+        android:src="@drawable/ridi_brightness_plus" />
+
+    <!-- The level stack itself is the control: drag it to set the value. -->
+    <com.android.settings.ridi.RidiLevelBar
+        android:id="@+id/level_stack"
+        android:layout_width="66dp"
+        android:layout_height="0dp"
+        android:layout_marginTop="16dp"
+        android:layout_weight="1"
+        android:contentDescription="@null" />
+
+    <TextView
+        android:id="@+id/level_text"
+        android:layout_width="match_parent"
+        android:layout_height="28dp"
+        android:layout_marginTop="6dp"
+        android:gravity="center"
+        android:includeFontPadding="false"
+        android:textColor="#ff000000"
+        android:textSize="14sp" />
+
+    <ImageButton
+        android:id="@+id/decrease"
+        android:layout_width="53dp"
+        android:layout_height="53dp"
+        android:layout_marginTop="6dp"
+        android:background="@drawable/ridi_brightness_button"
+        android:contentDescription="@null"
+        android:src="@drawable/ridi_brightness_minus" />
+
+    <TextView
+        android:id="@+id/low_label"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:layout_marginTop="10dp"
+        android:gravity="center"
+        android:textColor="#ff666666"
+        android:textSize="14sp" />
+</LinearLayout>
diff --git a/packages/apps/Settings/res/layout/ridi_frontlight_settings.xml b/packages/apps/Settings/res/layout/ridi_frontlight_settings.xml
new file mode 100644
index 0000000..00d051a
--- /dev/null
+++ b/packages/apps/Settings/res/layout/ridi_frontlight_settings.xml
@@ -0,0 +1,53 @@
+<?xml version="1.0" encoding="utf-8"?>
+<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:background="@drawable/ridi_panel_background">
+
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="match_parent"
+        android:orientation="vertical">
+
+        <TextView
+            android:id="@+id/frontlight_back"
+            android:layout_width="match_parent"
+            android:layout_height="@dimen/ridi_title_height"
+            android:background="@drawable/ridi_row_background"
+            android:drawableStart="@drawable/ridi_panel_back"
+            android:drawablePadding="7dp"
+            android:gravity="center_vertical"
+            android:paddingStart="5dp"
+            android:text="@string/ridi_frontlight"
+            android:textColor="#ff000000"
+            android:textSize="18sp"
+            android:textStyle="bold" />
+
+        <LinearLayout
+            android:layout_width="match_parent"
+            android:layout_height="0dp"
+            android:layout_weight="1"
+            android:baselineAligned="false"
+            android:orientation="horizontal">
+
+            <include
+                android:id="@+id/brightness_column"
+                layout="@layout/ridi_frontlight_column"
+                android:layout_width="0dp"
+                android:layout_height="match_parent"
+                android:layout_weight="1" />
+
+            <View
+                android:layout_width="1dp"
+                android:layout_height="match_parent"
+                android:background="#ff000000" />
+
+            <include
+                android:id="@+id/temperature_column"
+                layout="@layout/ridi_frontlight_column"
+                android:layout_width="0dp"
+                android:layout_height="match_parent"
+                android:layout_weight="1" />
+        </LinearLayout>
+    </LinearLayout>
+</FrameLayout>
diff --git a/packages/apps/Settings/res/layout/ridi_reader_settings.xml b/packages/apps/Settings/res/layout/ridi_reader_settings.xml
new file mode 100644
index 0000000..25625f5
--- /dev/null
+++ b/packages/apps/Settings/res/layout/ridi_reader_settings.xml
@@ -0,0 +1,99 @@
+<?xml version="1.0" encoding="utf-8"?>
+<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:background="#ffffffff"
+    android:foregroundGravity="center">
+
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="match_parent"
+        android:background="#ffffffff"
+        android:orientation="vertical">
+
+        <!-- Stock PanelTitleView: 48dp, white, 40dp icon and 18sp title. -->
+        <LinearLayout
+            android:layout_width="match_parent"
+            android:layout_height="@dimen/ridi_title_height"
+            android:gravity="center_vertical"
+            android:orientation="horizontal"
+            android:paddingStart="4dp"
+            android:paddingEnd="8dp">
+
+            <ImageView
+                android:layout_width="40dp"
+                android:layout_height="40dp"
+                android:contentDescription="@null"
+                android:src="@drawable/ridi_panel_icon_settings" />
+
+            <TextView
+                android:layout_width="0dp"
+                android:layout_height="match_parent"
+                android:layout_weight="1"
+                android:drawablePadding="7dp"
+                android:gravity="center_vertical"
+                android:text="@string/ridi_reader_settings_title"
+                android:textColor="#ff000000"
+                android:textSize="18sp"
+                android:textStyle="bold" />
+        </LinearLayout>
+
+        <FrameLayout
+            android:layout_width="match_parent"
+            android:layout_height="@dimen/ridi_tab_height"
+            android:layout_marginBottom="4dp">
+
+            <LinearLayout
+                android:layout_width="match_parent"
+                android:layout_height="match_parent"
+                android:baselineAligned="false"
+                android:orientation="horizontal"
+                android:paddingStart="12dp"
+                android:paddingEnd="12dp">
+
+                <TextView
+                    android:id="@+id/tab_display"
+                    style="@style/RidiReaderTab"
+                    android:background="@drawable/ridi_tab_selected"
+                    android:text="@string/ridi_tab_display" />
+
+                <TextView
+                    android:id="@+id/tab_network"
+                    style="@style/RidiReaderTab"
+                    android:text="@string/ridi_tab_network" />
+
+                <TextView
+                    android:id="@+id/tab_apps"
+                    style="@style/RidiReaderTab"
+                    android:text="@string/ridi_tab_apps" />
+
+                <TextView
+                    android:id="@+id/tab_device"
+                    style="@style/RidiReaderTab"
+                    android:text="@string/ridi_tab_device" />
+            </LinearLayout>
+
+            <View
+                android:layout_width="match_parent"
+                android:layout_height="1dp"
+                android:layout_gravity="bottom"
+                android:background="#ff000000" />
+        </FrameLayout>
+
+        <ListView
+            android:id="@+id/settings_list"
+            android:layout_width="match_parent"
+            android:layout_height="0dp"
+            android:layout_weight="1"
+            android:animationCache="false"
+            android:cacheColorHint="#ffffffff"
+            android:divider="@drawable/ridi_row_divider"
+            android:dividerHeight="1dp"
+            android:drawSelectorOnTop="false"
+            android:fastScrollEnabled="false"
+            android:listSelector="@android:color/transparent"
+            android:overScrollMode="never"
+            android:scrollbars="none"
+            android:scrollingCache="false" />
+    </LinearLayout>
+</FrameLayout>
diff --git a/packages/apps/Settings/res/layout/ridi_setting_row.xml b/packages/apps/Settings/res/layout/ridi_setting_row.xml
