+ */
+package com.android.settings.ridi;
+
+import android.content.ContentResolver;
+import android.provider.Settings;
+
+/**
+ * Settings-side mirror of SystemUI's reader screensaver keys.
+ *
+ * Keep these in sync with
+ * {@code com.android.systemui.ridi.ReaderScreensaverSettings}.
+ */
+final class RidiScreensaverSettings {
+    static final String ENABLED = "ridi_screensaver_enabled";
+    static final String STYLE = "ridi_screensaver_style";
+    static final String SHOW_CLOCK = "ridi_screensaver_show_clock";
+    static final String SHOW_BATTERY = "ridi_screensaver_show_battery";
+
+    static final int STYLE_BLANK = 0;
+    static final int STYLE_CLOCK = 1;
+    static final int STYLE_KEEP_CONTENT = 2;
+
+    static final int DEFAULT_STYLE = STYLE_CLOCK;
+
+    static final String[] STYLE_LABELS = {
+            "안내 문구만",
+            "시계",
+            "마지막 화면 유지"
+    };
+
+    private RidiScreensaverSettings() {}
+
+    static boolean isEnabled(ContentResolver resolver) {
+        return Settings.System.getInt(resolver, ENABLED, 1) != 0;
+    }
+
+    static void setEnabled(ContentResolver resolver, boolean enabled) {
+        Settings.System.putInt(resolver, ENABLED, enabled ? 1 : 0);
+    }
+
+    static int getStyle(ContentResolver resolver) {
+        final int style = Settings.System.getInt(resolver, STYLE, DEFAULT_STYLE);
+        return (style < STYLE_BLANK || style > STYLE_KEEP_CONTENT)
+                ? DEFAULT_STYLE : style;
+    }
+
+    static void setStyle(ContentResolver resolver, int style) {
+        Settings.System.putInt(resolver, STYLE, style);
+    }
+
+    static boolean showBattery(ContentResolver resolver) {
+        return Settings.System.getInt(resolver, SHOW_BATTERY, 1) != 0;
+    }
+
+    static void setShowBattery(ContentResolver resolver, boolean show) {
+        Settings.System.putInt(resolver, SHOW_BATTERY, show ? 1 : 0);
+    }
+
+    static String styleLabel(ContentResolver resolver) {
+        return STYLE_LABELS[getStyle(resolver)];
+    }
+}
diff --git a/packages/apps/Settings/src/com/android/settings/ridi/RidiWifiSettingsActivity.java b/packages/apps/Settings/src/com/android/settings/ridi/RidiWifiSettingsActivity.java
