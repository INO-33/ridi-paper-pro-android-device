@@ -0,0 +1,45 @@
+/*
+ * Copyright (C) 2026 E70Q10 Android port
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ */
+package com.android.settings.ridi;
+
+import android.graphics.Rect;
+import android.view.View;
+
+/** Settings-side use of the stock RIDI/Onyx packed E Ink View ABI. */
+final class RidiEinkRefresh {
+    static final int REAGL_PARTIAL_NOWAIT =
+            View.EINK_WAVEFORM_MODE_REAGL
+                    | View.EINK_UPDATE_MODE_PARTIAL
+                    | View.EINK_WAIT_MODE_NOWAIT;
+
+    private RidiEinkRefresh() {}
+
+    /**
+     * Settings is its own process, so this process-global default covers the
+     * AOSP detail activities launched from the RIDI settings home without
+     * changing the policy of launcher or reader applications.
+     */
+    static void configure(View decorView) {
+        View.setGlobalUpdateMode(REAGL_PARTIAL_NOWAIT);
+        View.setFirstDrawUpdateMode(REAGL_PARTIAL_NOWAIT);
+        decorView.setDefaultUpdateMode(REAGL_PARTIAL_NOWAIT);
+    }
+
+    static void invalidate(View view) {
+        if (view == null) {
+            return;
+        }
+        view.setDefaultUpdateMode(REAGL_PARTIAL_NOWAIT);
+        final int width = view.getWidth();
+        final int height = view.getHeight();
+        if (width > 0 && height > 0) {
+            view.invalidate(new Rect(0, 0, width, height),
+                    REAGL_PARTIAL_NOWAIT);
+        } else {
+            view.invalidate(REAGL_PARTIAL_NOWAIT);
+        }
+    }
+}
diff --git a/packages/apps/Settings/src/com/android/settings/ridi/RidiFrontlightActivity.java b/packages/apps/Settings/src/com/android/settings/ridi/RidiFrontlightActivity.java
new file mode 100644
index 0000000..ac55124
--- /dev/null
+++ b/packages/apps/Settings/src/com/android/settings/ridi/RidiFrontlightActivity.java
@@ -0,0 +1,181 @@
+/*
+ * Copyright (C) 2026 E70Q10 Android port
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ */
+package com.android.settings.ridi;
+
+import android.app.Activity;
+import android.os.Bundle;
+import android.util.DisplayMetrics;
+import android.view.View;
+import android.view.WindowManager;
+import android.widget.ImageView;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import com.android.settings.R;
+
+/** Fixed, animation-free frontlight and color-temperature controls. */
+public class RidiFrontlightActivity extends Activity {
+    private static final int BRIGHTNESS_STEP = 5;
+
+    private RidiLevelBar mBrightnessBar;
+    private TextView mBrightnessValue;
+    private RidiLevelBar mColorBar;
+    private TextView mColorValue;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        RidiEinkRefresh.configure(getWindow().getDecorView());
+        setContentView(R.layout.ridi_frontlight_settings);
+
+        final View brightness = findViewById(R.id.brightness_column);
+        final View color = findViewById(R.id.temperature_column);
+        bindBrightnessColumn(brightness);
+        bindColorColumn(color);
+
+        findViewById(R.id.frontlight_back).setOnClickListener(v -> finish());
+        updateValues();
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        updateValues();
+        overridePendingTransition(0, 0);
+    }
+
+    @Override
+    protected void onStart() {
+        super.onStart();
+        final DisplayMetrics metrics = new DisplayMetrics();
+        getWindowManager().getDefaultDisplay().getMetrics(metrics);
+        final int panelWidth = Math.min(
+                Math.round(510f * metrics.density),
+                Math.round(metrics.widthPixels * 0.94f));
+        final int panelHeight = Math.min(
+                Math.round(685f * metrics.density),
+                Math.round(metrics.heightPixels * 0.92f));
+        getWindow().setDimAmount(0f);
+        getWindow().clearFlags(WindowManager.LayoutParams.FLAG_DIM_BEHIND);
+        getWindow().getDecorView().setElevation(0f);
+        getWindow().setLayout(panelWidth, panelHeight);
+    }
+
+    @Override
+    public void finish() {
+        super.finish();
+        overridePendingTransition(0, 0);
+    }
+
+    private void bindBrightnessColumn(View column) {
+        ((TextView) column.findViewById(R.id.control_title))
+                .setText(R.string.ridi_brightness);
+        ((TextView) column.findViewById(R.id.high_label))
+                .setText(R.string.ridi_max_brightness);
+        ((TextView) column.findViewById(R.id.low_label))
+                .setText(R.string.ridi_min_brightness);
+        ((ImageView) column.findViewById(R.id.control_icon))
+                .setImageResource(R.drawable.ridi_frontlight_brightness);
+        mBrightnessBar = column.findViewById(R.id.level_stack);
+        mBrightnessValue = column.findViewById(R.id.level_text);
+
+        column.findViewById(R.id.increase).setOnClickListener(v ->
+                changeBrightness(BRIGHTNESS_STEP));
+        column.findViewById(R.id.decrease).setOnClickListener(v ->
+                changeBrightness(-BRIGHTNESS_STEP));
+        mBrightnessBar.setOnLevelChangeListener(new FrontlightBarListener(true));
+    }
+
+    private void bindColorColumn(View column) {
+        ((TextView) column.findViewById(R.id.control_title))
+                .setText(R.string.ridi_color_temperature);
+        ((TextView) column.findViewById(R.id.high_label))
+                .setText(R.string.ridi_warm_color);
+        ((TextView) column.findViewById(R.id.low_label))
+                .setText(R.string.ridi_less_warm_color);
+        ((ImageView) column.findViewById(R.id.control_icon))
+                .setImageResource(R.drawable.ridi_frontlight_color);
+        mColorBar = column.findViewById(R.id.level_stack);
+        mColorValue = column.findViewById(R.id.level_text);
+
+        column.findViewById(R.id.increase).setOnClickListener(v ->
+                changeColor(1));
+        column.findViewById(R.id.decrease).setOnClickListener(v ->
+                changeColor(-1));
+        mColorBar.setOnLevelChangeListener(new FrontlightBarListener(false));
+    }
+
+    private void changeBrightness(int delta) {
+        if (!RidiFrontlightController.setBrightness(getContentResolver(),
+                RidiFrontlightController.getBrightness() + delta)) {
+            showWriteError();
+        }
+        updateValues();
+    }
+
+    private void changeColor(int delta) {
+        if (!RidiFrontlightController.setColor(getContentResolver(),
+                RidiFrontlightController.getColor() + delta)) {
+            showWriteError();
+        }
+        updateValues();
+    }
+
+    private void updateValues() {
+        if (mBrightnessBar == null || mColorBar == null) {
+            return;
+        }
+        final int brightness = RidiFrontlightController.getBrightness();
+        final int maxBrightness = RidiFrontlightController.getMaxBrightness();
+        mBrightnessBar.setMax(maxBrightness);
+        mBrightnessBar.setLevel(brightness);
+        mBrightnessValue.setText(brightness + " / " + maxBrightness);
+        RidiEinkRefresh.invalidate(mBrightnessBar);
+        RidiEinkRefresh.invalidate(mBrightnessValue);
+
+        final int color = RidiFrontlightController.getColor();
+        final int maxColor = RidiFrontlightController.getMaxColor();
+        mColorBar.setMax(maxColor);
+        mColorBar.setLevel(color);
+        mColorValue.setText(color + " / " + maxColor);
+        RidiEinkRefresh.invalidate(mColorBar);
+        RidiEinkRefresh.invalidate(mColorValue);
+    }
+
+    private void showWriteError() {
+        Toast.makeText(this, "프론트라이트 장치에 쓸 수 없습니다.",
+                Toast.LENGTH_SHORT).show();
+    }
+
+    private final class FrontlightBarListener
+            implements RidiLevelBar.OnLevelChangeListener {
+        private final boolean mBrightness;
+
+        FrontlightBarListener(boolean brightness) {
+            mBrightness = brightness;
+        }
+
+        @Override
+        public void onLevelChanging(RidiLevelBar bar, int level) {
+            final TextView value = mBrightness ? mBrightnessValue : mColorValue;
+            value.setText(level + " / " + bar.getMax());
+            RidiEinkRefresh.invalidate(value);
+        }
+
+        @Override
+        public void onLevelChanged(RidiLevelBar bar, int level) {
+            final boolean success = mBrightness
+                    ? RidiFrontlightController.setBrightness(
+                            getContentResolver(), level)
+                    : RidiFrontlightController.setColor(
+                            getContentResolver(), level);
+            if (!success) {
+                showWriteError();
+            }
+            updateValues();
+        }
+    }
+}
diff --git a/packages/apps/Settings/src/com/android/settings/ridi/RidiFrontlightController.java b/packages/apps/Settings/src/com/android/settings/ridi/RidiFrontlightController.java
new file mode 100644
index 0000000..a2dc037
--- /dev/null
+++ b/packages/apps/Settings/src/com/android/settings/ridi/RidiFrontlightController.java
@@ -0,0 +1,94 @@
+/*
+ * Copyright (C) 2026 E70Q10 Android port
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ */
+package com.android.settings.ridi;
+
+import android.content.ContentResolver;
+import android.provider.Settings;
+import android.util.Log;
+
+import java.io.BufferedReader;
+import java.io.FileReader;
+import java.io.FileWriter;
+import java.io.IOException;
+
+/**
+ * Small synchronous controller for the E70Q10 two-channel LM3630A frontlight.
+ *
+ * The kernel owns the brightness/color mixing policy. Settings only writes the
+ * two stable backlight class attributes exposed by the board driver.
+ */
+final class RidiFrontlightController {
+    private static final String TAG = "RidiFrontlight";
+    private static final String BASE = "/sys/class/backlight/lm3630a_led/";
+    private static final String BRIGHTNESS = BASE + "brightness";
+    private static final String MAX_BRIGHTNESS = BASE + "max_brightness";
+    private static final String COLOR = BASE + "color";
+    private static final String MAX_COLOR = BASE + "max_color";
+
+    private static final String SETTING_BRIGHTNESS = "ridi_frontlight_level";
+    private static final String SETTING_COLOR = "ridi_frontlight_color";
+
+    private RidiFrontlightController() {}
+
+    static int getBrightness() {
+        return readInt(BRIGHTNESS, 0);
+    }
+
+    static int getMaxBrightness() {
+        return Math.max(1, readInt(MAX_BRIGHTNESS, 100));
+    }
+
+    static int getColor() {
+        return readInt(COLOR, 0);
+    }
+
+    static int getMaxColor() {
+        return Math.max(1, readInt(MAX_COLOR, 10));
+    }
+
+    static boolean setBrightness(ContentResolver resolver, int requested) {
+        final int value = clamp(requested, 0, getMaxBrightness());
+        if (!writeInt(BRIGHTNESS, value)) {
+            return false;
+        }
+        Settings.System.putInt(resolver, SETTING_BRIGHTNESS, value);
+        return true;
+    }
+
+    static boolean setColor(ContentResolver resolver, int requested) {
+        final int value = clamp(requested, 0, getMaxColor());
+        if (!writeInt(COLOR, value)) {
+            return false;
+        }
+        Settings.System.putInt(resolver, SETTING_COLOR, value);
+        return true;
+    }
+
+    private static int readInt(String path, int fallback) {
+        try (BufferedReader reader = new BufferedReader(new FileReader(path))) {
+            return Integer.parseInt(reader.readLine().trim());
+        } catch (IOException | NumberFormatException e) {
+            Log.w(TAG, "Cannot read " + path, e);
+            return fallback;
+        }
+    }
+
+    private static boolean writeInt(String path, int value) {
+        try (FileWriter writer = new FileWriter(path, false)) {
+            writer.write(Integer.toString(value));
+            writer.write('\n');
+            writer.flush();
+            return true;
+        } catch (IOException e) {
+            Log.e(TAG, "Cannot write " + path, e);
+            return false;
+        }
+    }
+
+    private static int clamp(int value, int min, int max) {
+        return Math.max(min, Math.min(max, value));
+    }
+}
