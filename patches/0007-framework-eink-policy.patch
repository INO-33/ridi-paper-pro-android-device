+/*
+ * Copyright (C) 2026 E70Q10 Android port
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ */
+package com.android.systemui.ridi;
+
+import android.content.ContentResolver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.graphics.PixelFormat;
+import android.os.BatteryManager;
+import android.text.format.DateFormat;
+import android.util.Log;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.WindowManager;
+import android.widget.TextView;
+
+import com.android.systemui.R;
+
+import java.util.Date;
+
+/**
+ * Draws the suspend image once, just before the display is powered down.
+ *
+ * An E Ink panel is bistable: the last frame stays on the glass with no power
+ * and no further drawing. The kernel flushes pending EPDC updates before
+ * FB_BLANK_POWERDOWN, so a frame submitted here is guaranteed to reach the
+ * panel. The update therefore uses GC16 with WAIT, which blocks until the
+ * waveform has finished and leaves a clean, residue-free still image.
+ *
+ * This is a plain window rather than an activity: starting an activity while the
+ * device is going to sleep races with the screen-off path, and there is no
+ * reason to keep a task around for a static picture.
+ */
+public class ReaderScreensaverController {
+    private static final String TAG = "ReaderScreensaver";
+
+    private final Context mContext;
+    private final WindowManager mWindowManager;
+
+    private View mView;
+
+    public ReaderScreensaverController(Context context) {
+        mContext = context;
+        mWindowManager = context.getSystemService(WindowManager.class);
+    }
+
+    /** Called while the screen is still powered, as sleep begins. */
+    public void onStartedGoingToSleep() {
+        final ContentResolver resolver = mContext.getContentResolver();
+        if (!ReaderScreensaverSettings.isEnabled(resolver)) {
+            return;
+        }
+        final int style = ReaderScreensaverSettings.getStyle(resolver);
+        if (style == ReaderScreensaverSettings.STYLE_KEEP_CONTENT) {
+            // Nothing to draw: not updating the panel already keeps the last
+            // frame, which is exactly what this style asks for.
+            return;
+        }
+        show(style);
+    }
+
+    /** Called on wake; removes the still image so the UI is visible again. */
+    public void onStartedWakingUp() {
+        if (mView == null) {
+            return;
+        }
+        try {
+            mWindowManager.removeViewImmediate(mView);
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Could not remove the suspend image", e);
+        }
+        mView = null;
+    }
+
+    private void show(int style) {
+        if (mView != null) {
+            return;
+        }
+        final ContentResolver resolver = mContext.getContentResolver();
+        final View view = LayoutInflater.from(mContext)
+                .inflate(R.layout.ridi_screensaver, null);
+        bind(view, style, resolver);
+
+        final WindowManager.LayoutParams lp = new WindowManager.LayoutParams(
+                WindowManager.LayoutParams.MATCH_PARENT,
+                WindowManager.LayoutParams.MATCH_PARENT,
+                WindowManager.LayoutParams.TYPE_SYSTEM_OVERLAY,
+                WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE
+                        | WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
+                        | WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN
+                        | WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,
+                PixelFormat.OPAQUE);
+        lp.setTitle("ReaderScreensaver");
+        // A dim or animation layer would be baked into the retained image.
+        lp.dimAmount = 0f;
+        lp.windowAnimations = 0;
+
+        try {
+            mWindowManager.addView(view, lp);
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Could not show the suspend image", e);
+            return;
+        }
+        mView = view;
+
+        /*
+         * Submit one full GC16 update and wait for it. The panel keeps this
+         * frame for the whole sleep period, so no further drawing happens.
+         */
+        ReaderEinkRefresh.fullRefresh(view);
+    }
+
+    private void bind(View view, int style, ContentResolver resolver) {
+        final TextView clock = view.findViewById(R.id.screensaver_clock);
+        final TextView date = view.findViewById(R.id.screensaver_date);
+        final TextView battery = view.findViewById(R.id.screensaver_battery);
+        final TextView notice = view.findViewById(R.id.screensaver_notice);
+
+        final boolean wantClock = style == ReaderScreensaverSettings.STYLE_CLOCK
+                && ReaderScreensaverSettings.showClock(resolver);
+        final boolean wantBattery = ReaderScreensaverSettings.showBattery(resolver);
+
+        clock.setVisibility(wantClock ? View.VISIBLE : View.GONE);
+        date.setVisibility(wantClock ? View.VISIBLE : View.GONE);
+        notice.setVisibility(wantClock ? View.GONE : View.VISIBLE);
+        battery.setVisibility(wantBattery ? View.VISIBLE : View.GONE);
+
+        final Date now = new Date();
+        if (wantClock) {
+            clock.setText(DateFormat.getTimeFormat(mContext).format(now));
+            date.setText(DateFormat.getLongDateFormat(mContext).format(now));
+        }
+        if (wantBattery) {
+            battery.setText(mContext.getString(R.string.ridi_screensaver_battery,
+                    readBatteryLevel()));
+        }
+    }
+
+    private int readBatteryLevel() {
+        final Intent status = mContext.registerReceiver(null,
+                new IntentFilter(Intent.ACTION_BATTERY_CHANGED));
+        if (status == null) {
+            return 0;
+        }
+        final int level = status.getIntExtra(BatteryManager.EXTRA_LEVEL, 0);
+        final int scale = status.getIntExtra(BatteryManager.EXTRA_SCALE, 100);
+        return scale > 0 ? Math.round(level * 100f / scale) : 0;
+    }
+}
