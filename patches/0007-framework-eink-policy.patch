+
+        <LinearLayout
+            android:id="@+id/ridi_quick_notifications"
+            style="@style/RidiReaderQuickButton">
+            <ImageView
+                android:layout_width="50dp"
+                android:layout_height="50dp"
+                android:contentDescription="@null"
+                android:padding="10dp"
