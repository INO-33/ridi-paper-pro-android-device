diff --git a/frameworks/base/packages/SystemUI/res/layout/ridi_nav_frontlight.xml b/frameworks/base/packages/SystemUI/res/layout/ridi_nav_frontlight.xml
new file mode 100644
index 00000000..8d1c1193
--- /dev/null
+++ b/frameworks/base/packages/SystemUI/res/layout/ridi_nav_frontlight.xml
@@ -0,0 +1,24 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     Navigation bar key that opens the frontlight popup.
+
+     Uses the stock RIDI 4.4.2 frontlight artwork so it matches the rest of the
+     reader UI. keyCode stays 0 because this key runs an action instead of
+     injecting a key event; NavigationBarFragment attaches the click listener.
+-->
+<com.android.systemui.statusbar.policy.KeyButtonView
+    xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:systemui="http://schemas.android.com/apk/res-auto"
+    android:id="@+id/ridi_frontlight"
+    android:layout_width="@dimen/navigation_key_width"
+    android:layout_height="match_parent"
+    android:layout_weight="0"
+    android:scaleType="fitCenter"
+    android:contentDescription="@string/ridi_quick_frontlight"
+    android:src="@drawable/ridi_quick_frontlight"
+    android:paddingTop="8dp"
+    android:paddingBottom="8dp"
+    android:paddingStart="@dimen/navigation_key_padding"
+    android:paddingEnd="@dimen/navigation_key_padding"
+    systemui:playSound="false"
+    />
diff --git a/frameworks/base/packages/SystemUI/res/layout/ridi_nav_refresh.xml b/frameworks/base/packages/SystemUI/res/layout/ridi_nav_refresh.xml
new file mode 100644
index 00000000..17cfb61c
--- /dev/null
+++ b/frameworks/base/packages/SystemUI/res/layout/ridi_nav_refresh.xml
@@ -0,0 +1,24 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     Navigation bar key that forces one full-screen GC16 panel refresh.
+
+     Uses the stock RIDI 4.4.2 refresh artwork. keyCode stays 0 because this key
+     runs an action instead of injecting a key event; NavigationBarFragment
+     attaches the click listener.
+-->
+<com.android.systemui.statusbar.policy.KeyButtonView
+    xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:systemui="http://schemas.android.com/apk/res-auto"
+    android:id="@+id/ridi_refresh"
+    android:layout_width="@dimen/navigation_key_width"
+    android:layout_height="match_parent"
+    android:layout_weight="0"
+    android:scaleType="fitCenter"
+    android:contentDescription="@string/ridi_quick_refresh"
+    android:src="@drawable/ridi_quick_refresh"
+    android:paddingTop="8dp"
+    android:paddingBottom="8dp"
+    android:paddingStart="@dimen/navigation_key_padding"
+    android:paddingEnd="@dimen/navigation_key_padding"
+    systemui:playSound="false"
+    />
diff --git a/frameworks/base/packages/SystemUI/res/layout/ridi_reader_notification_panel.xml b/frameworks/base/packages/SystemUI/res/layout/ridi_reader_notification_panel.xml
new file mode 100644
index 00000000..b7656f9a
--- /dev/null
+++ b/frameworks/base/packages/SystemUI/res/layout/ridi_reader_notification_panel.xml
@@ -0,0 +1,88 @@
+<?xml version="1.0" encoding="utf-8"?>
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="wrap_content"
+    android:background="@drawable/ridi_panel_background"
+    android:orientation="vertical">
+
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="48dp"
+        android:gravity="center_vertical"
+        android:orientation="horizontal"
+        android:paddingStart="4dp"
+        android:paddingEnd="4dp">
+
+        <ImageView
+            android:layout_width="40dp"
+            android:layout_height="40dp"
+            android:contentDescription="@null"
+            android:padding="8dp"
+            android:src="@drawable/ridi_quick_notifications" />
+
+        <TextView
+            android:layout_width="0dp"
+            android:layout_height="match_parent"
+            android:layout_weight="1"
+            android:gravity="center_vertical"
+            android:paddingStart="7dp"
+            android:text="@string/ridi_notification_panel_title"
+            android:textColor="#ff000000"
+            android:textSize="18sp"
+            android:textStyle="bold" />
+
+        <TextView
+            android:id="@+id/ridi_notification_close"
+            android:layout_width="48dp"
+            android:layout_height="48dp"
+            android:background="@drawable/ridi_quick_cell_background"
+            android:gravity="center"
+            android:text="×"
+            android:textColor="#ff000000"
+            android:textSize="28sp" />
+    </LinearLayout>
+
+    <FrameLayout
+        android:layout_width="match_parent"
+        android:layout_height="500dp"
+        android:background="#ffffffff">
+
+        <ListView
+            android:id="@+id/ridi_notification_list"
+            android:layout_width="match_parent"
+            android:layout_height="match_parent"
+            android:cacheColorHint="#ffffffff"
+            android:divider="#ff999999"
+            android:dividerHeight="1dp"
+            android:drawSelectorOnTop="false"
+            android:fadingEdge="none"
+            android:fastScrollEnabled="false"
+            android:overScrollMode="never"
+            android:scrollbars="none" />
+
+        <TextView
+            android:id="@+id/ridi_notification_empty"
+            android:layout_width="match_parent"
+            android:layout_height="match_parent"
+            android:gravity="center"
+            android:text="@string/ridi_notification_empty"
+            android:textColor="#ff333333"
+            android:textSize="16sp" />
+    </FrameLayout>
+
+    <View
+        android:layout_width="match_parent"
+        android:layout_height="1dp"
+        android:background="#ff777777" />
+
+    <Button
+        android:id="@+id/ridi_notification_clear"
+        android:layout_width="match_parent"
+        android:layout_height="48dp"
+        android:background="@drawable/ridi_quick_cell_background"
+        android:gravity="center"
+        android:text="@string/ridi_notification_clear"
+        android:textColor="#ff000000"
+        android:textSize="15sp"
+        android:textStyle="bold" />
+</LinearLayout>
