@@ -0,0 +1,251 @@
+/*
+ * Copyright (C) 2026 E70Q10 Android port
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ */
+package com.android.systemui.ridi;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.net.wifi.WifiManager;
+import android.os.Bundle;
+import android.os.SystemProperties;
+import android.util.DisplayMetrics;
+import android.view.View;
+import android.view.Window;
+import android.view.WindowManager;
+import android.widget.SeekBar;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import com.android.systemui.R;
+
+/**
+ * Opaque, fixed quick panel for E Ink.
+ *
+ * This intentionally does not reuse the draggable QS shade: there are no
+ * flings, expansion animations, translucent scrims, paged tiles or ripples.
+ */
+public class ReaderQuickPanelActivity extends Activity {
+    private static final int BRIGHTNESS_STEP = 5;
+
+    private WifiManager mWifi;
+    private View mWifiButton;
+    private TextView mWifiLabel;
+    private SeekBar mBrightnessBar;
+    private TextView mBrightnessValue;
+    private SeekBar mColorBar;
+    private TextView mColorValue;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        requestWindowFeature(Window.FEATURE_NO_TITLE);
+        getWindow().setWindowAnimations(0);
+        getWindow().setDimAmount(0f);
+        getWindow().clearFlags(WindowManager.LayoutParams.FLAG_DIM_BEHIND);
+        setContentView(R.layout.ridi_reader_quick_panel);
+        getWindow().getDecorView().setElevation(0f);
+
+        mWifi = (WifiManager) getApplicationContext().getSystemService(Context.WIFI_SERVICE);
+        mWifiButton = findViewById(R.id.ridi_quick_wifi);
+        mWifiLabel = findViewById(R.id.ridi_quick_wifi_label);
+        mBrightnessBar = findViewById(R.id.ridi_brightness_level);
+        mBrightnessValue = findViewById(R.id.ridi_brightness_value);
+        mColorBar = findViewById(R.id.ridi_color_level);
+        mColorValue = findViewById(R.id.ridi_color_value);
+
+        findViewById(R.id.ridi_quick_close).setOnClickListener(v -> finish());
+        findViewById(R.id.ridi_quick_refresh).setOnClickListener(v -> requestFullRefresh());
+        mWifiButton.setOnClickListener(v -> toggleWifi());
+        findViewById(R.id.ridi_quick_notifications).setOnClickListener(v ->
+                openNotifications());
+        findViewById(R.id.ridi_brightness_down).setOnClickListener(v ->
+                changeBrightness(-BRIGHTNESS_STEP));
+        findViewById(R.id.ridi_brightness_up).setOnClickListener(v ->
+                changeBrightness(BRIGHTNESS_STEP));
+        findViewById(R.id.ridi_color_down).setOnClickListener(v -> changeColor(-1));
+        findViewById(R.id.ridi_color_up).setOnClickListener(v -> changeColor(1));
+        findViewById(R.id.ridi_open_settings).setOnClickListener(v -> openSettings());
+        findViewById(R.id.ridi_power).setOnClickListener(v -> confirmShutdown());
+        bindSliders();
+        updateState();
+    }
+
+    @Override
+    protected void onStart() {
+        super.onStart();
+        final DisplayMetrics metrics = new DisplayMetrics();
+        getWindowManager().getDefaultDisplay().getMetrics(metrics);
+        final int stockPanelWidth = (int) (510f * metrics.density + 0.5f);
+        getWindow().setLayout(Math.min((int) (metrics.widthPixels * 0.94f), stockPanelWidth),
+                WindowManager.LayoutParams.WRAP_CONTENT);
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        overridePendingTransition(0, 0);
+        updateState();
+    }
+
+    @Override
+    public void finish() {
+        super.finish();
+        overridePendingTransition(0, 0);
+    }
+
+    private void toggleWifi() {
+        if (mWifi == null) {
+            return;
+        }
+        final boolean enable = !mWifi.isWifiEnabled();
+        final boolean accepted = mWifi.setWifiEnabled(enable);
+        mWifiLabel.setText(accepted
+                ? (enable ? "Wi-Fi 켜는 중" : "Wi-Fi 끄는 중")
+                : "Wi-Fi 전환 실패");
+    }
+
+    private void changeBrightness(int delta) {
+        final ReaderFrontlightController.State current =
+                ReaderFrontlightController.state(this);
+        final ReaderFrontlightController.State result =
+                ReaderFrontlightController.setBrightness(
+                        this, current.brightness + delta);
+        if (!result.success) {
+            showFrontlightError();
+        }
+        applyFrontlightState(result);
+    }
+
+    private void changeColor(int delta) {
+        final ReaderFrontlightController.State current =
+                ReaderFrontlightController.state(this);
+        final ReaderFrontlightController.State result =
+                ReaderFrontlightController.setColor(this, current.color + delta);
+        if (!result.success) {
+            showFrontlightError();
+        }
+        applyFrontlightState(result);
+    }
+
+    private void bindSliders() {
+        mBrightnessBar.setOnSeekBarChangeListener(new SeekBar.OnSeekBarChangeListener() {
+            @Override
+            public void onProgressChanged(SeekBar seekBar, int progress, boolean fromUser) {
+                mBrightnessValue.setText(progress + " / " + seekBar.getMax());
+            }
+
+            @Override
+            public void onStartTrackingTouch(SeekBar seekBar) {}
+
+            @Override
+            public void onStopTrackingTouch(SeekBar seekBar) {
+                final ReaderFrontlightController.State result =
+                        ReaderFrontlightController.setBrightness(
+                                ReaderQuickPanelActivity.this, seekBar.getProgress());
+                if (!result.success) {
+                    showFrontlightError();
+                }
+                applyFrontlightState(result);
+            }
+        });
+        mColorBar.setOnSeekBarChangeListener(new SeekBar.OnSeekBarChangeListener() {
+            @Override
+            public void onProgressChanged(SeekBar seekBar, int progress, boolean fromUser) {
+                mColorValue.setText(progress + " / " + seekBar.getMax());
+            }
+
+            @Override
+            public void onStartTrackingTouch(SeekBar seekBar) {}
+
+            @Override
+            public void onStopTrackingTouch(SeekBar seekBar) {
+                final ReaderFrontlightController.State result =
+                        ReaderFrontlightController.setColor(
+                                ReaderQuickPanelActivity.this, seekBar.getProgress());
+                if (!result.success) {
+                    showFrontlightError();
+                }
+                applyFrontlightState(result);
+            }
+        });
+    }
+
+    private void updateState() {
+        if (mBrightnessBar == null) {
+            return;
+        }
+        applyFrontlightState(ReaderFrontlightController.state(this));
+
+        if (mWifi != null) {
+            mWifiLabel.setText(mWifi.isWifiEnabled() ? "Wi-Fi 켜짐" : "Wi-Fi 꺼짐");
+        }
+    }
+
+    private void applyFrontlightState(ReaderFrontlightController.State state) {
+        mBrightnessBar.setMax(state.maxBrightness);
+        mBrightnessBar.setProgress(state.brightness);
+        mBrightnessValue.setText(state.brightness + " / " + state.maxBrightness);
+
+        mColorBar.setMax(state.maxColor);
+        mColorBar.setProgress(state.color);
+        mColorValue.setText(state.color + " / " + state.maxColor);
+    }
+
+    private void requestFullRefresh() {
+        final int serial = SystemProperties.getInt(
+                "sys.ridi.epd.full_refresh_seq", 0) + 1;
+        SystemProperties.set("sys.ridi.epd.full_refresh_seq",
+                Integer.toString(serial == 0 ? 1 : serial));
+        getWindow().getDecorView().invalidate();
+    }
+
+    private void openSettings() {
+        final Intent intent = new Intent();
+        intent.setComponent(new ComponentName("com.android.settings",
+                "com.android.settings.ridi.RidiReaderSettingsActivity"));
+        intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TOP);
+        startActivity(intent);
+        finish();
+    }
+
+    private void openNotifications() {
+        startActivity(new Intent(this, ReaderNotificationPanelActivity.class)
+                .addFlags(Intent.FLAG_ACTIVITY_CLEAR_TOP
+                        | Intent.FLAG_ACTIVITY_NO_ANIMATION));
+        finish();
+    }
+
+    private void confirmShutdown() {
+        final AlertDialog dialog = new AlertDialog.Builder(this)
+                .setTitle("전원 끄기")
+                .setMessage("기기의 전원을 끌까요?")
+                .setNegativeButton(android.R.string.cancel, null)
+                .setPositiveButton("전원 끄기", (shutdownDialog, which) -> {
+                    final Intent intent = new Intent(Intent.ACTION_REQUEST_SHUTDOWN);
+                    intent.putExtra(Intent.EXTRA_KEY_CONFIRM, false);
+                    intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+                    startActivity(intent);
+                })
+                .create();
+        dialog.setOnShowListener(ignored -> {
+            final Window window = dialog.getWindow();
+            if (window != null) {
+                window.setWindowAnimations(0);
+                window.setDimAmount(0f);
+                window.clearFlags(WindowManager.LayoutParams.FLAG_DIM_BEHIND);
+                window.getDecorView().setElevation(0f);
+            }
+        });
+        dialog.show();
+    }
+
+    private void showFrontlightError() {
+        Toast.makeText(this, "프론트라이트 장치에 쓸 수 없습니다.",
+                Toast.LENGTH_SHORT).show();
+    }
+}
