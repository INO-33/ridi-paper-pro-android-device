@@ -0,0 +1,63 @@
+/*
+ * Copyright (C) 2026 E70Q10 Android port
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ */
+package com.android.systemui.ridi;
+
+import android.content.ContentResolver;
+import android.provider.Settings;
+
+/**
+ * Shared definition of the reader's screensaver settings.
+ *
+ * An E Ink panel keeps the last image without power, so the "screensaver" is a
+ * single still frame drawn once while the device suspends. It costs nothing to
+ * leave on screen, unlike an LCD screensaver.
+ *
+ * The Settings app writes these keys and SystemUI reads them.
+ */
+public final class ReaderScreensaverSettings {
+    /** 0 disables the screensaver, 1 enables it. */
+    public static final String ENABLED = "ridi_screensaver_enabled";
+
+    /** One of the {@code STYLE_*} values below. */
+    public static final String STYLE = "ridi_screensaver_style";
+
+    /** Show a clock on the suspend screen. */
+    public static final String SHOW_CLOCK = "ridi_screensaver_show_clock";
+
+    /** Show the battery level on the suspend screen. */
+    public static final String SHOW_BATTERY = "ridi_screensaver_show_battery";
+
+    /** Plain sheet with the "screen is off" notice. */
+    public static final int STYLE_BLANK = 0;
+    /** Large centred clock, the closest match to the stock reader. */
+    public static final int STYLE_CLOCK = 1;
+    /** Keep whatever was on screen and only draw a small footer. */
+    public static final int STYLE_KEEP_CONTENT = 2;
+
+    public static final int DEFAULT_STYLE = STYLE_CLOCK;
+
+    private ReaderScreensaverSettings() {}
+
+    public static boolean isEnabled(ContentResolver resolver) {
+        return Settings.System.getInt(resolver, ENABLED, 1) != 0;
+    }
+
+    public static int getStyle(ContentResolver resolver) {
+        final int style = Settings.System.getInt(resolver, STYLE, DEFAULT_STYLE);
+        if (style < STYLE_BLANK || style > STYLE_KEEP_CONTENT) {
+            return DEFAULT_STYLE;
+        }
+        return style;
+    }
+
+    public static boolean showClock(ContentResolver resolver) {
+        return Settings.System.getInt(resolver, SHOW_CLOCK, 1) != 0;
+    }
+
+    public static boolean showBattery(ContentResolver resolver) {
+        return Settings.System.getInt(resolver, SHOW_BATTERY, 1) != 0;
+    }
+}
