@@ -0,0 +1,82 @@
+/*
+ * Copyright (C) 2026 E70Q10 Android port
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ */
+package com.android.systemui.ridi;
+
+import android.content.Context;
+import android.net.Uri;
+import android.os.Bundle;
+import android.util.Log;
+
+/**
+ * Frontlight client for SystemUI.
+ *
+ * SystemUI does not run as android.uid.system, so it must not directly open the
+ * system-owned LM3630A sysfs nodes. Calls are synchronously forwarded through
+ * Settings' signature-protected provider.
+ */
+final class ReaderFrontlightController {
+    private static final String TAG = "ReaderFrontlight";
+    private static final Uri URI =
+            Uri.parse("content://com.android.settings.ridi.frontlight");
+
+    private static final String KEY_VALUE = "value";
+    private static final String KEY_SUCCESS = "success";
+    private static final String KEY_BRIGHTNESS = "brightness";
+    private static final String KEY_MAX_BRIGHTNESS = "max_brightness";
+    private static final String KEY_COLOR = "color";
+    private static final String KEY_MAX_COLOR = "max_color";
+
+    private ReaderFrontlightController() {}
+
+    static State state(Context context) {
+        return call(context, "get_state", 0);
+    }
+
+    static State setBrightness(Context context, int value) {
+        return call(context, "set_brightness", value);
+    }
+
+    static State setColor(Context context, int value) {
+        return call(context, "set_color", value);
+    }
+
+    private static State call(Context context, String method, int value) {
+        try {
+            final Bundle extras = new Bundle();
+            extras.putInt(KEY_VALUE, value);
+            final Bundle result = context.getContentResolver()
+                    .call(URI, method, null, extras);
+            if (result != null) {
+                return new State(
+                        result.getBoolean(KEY_SUCCESS, false),
+                        result.getInt(KEY_BRIGHTNESS, 0),
+                        Math.max(1, result.getInt(KEY_MAX_BRIGHTNESS, 100)),
+                        result.getInt(KEY_COLOR, 0),
+                        Math.max(1, result.getInt(KEY_MAX_COLOR, 10)));
+            }
+        } catch (RuntimeException e) {
+            Log.e(TAG, "Frontlight provider call failed: " + method, e);
+        }
+        return new State(false, 0, 100, 0, 10);
+    }
+
+    static final class State {
+        final boolean success;
+        final int brightness;
+        final int maxBrightness;
+        final int color;
+        final int maxColor;
+
+        State(boolean success, int brightness, int maxBrightness,
+                int color, int maxColor) {
+            this.success = success;
+            this.brightness = brightness;
+            this.maxBrightness = maxBrightness;
+            this.color = color;
+            this.maxColor = maxColor;
+        }
+    }
+}
diff --git a/frameworks/base/packages/SystemUI/src/com/android/systemui/ridi/ReaderNotificationPanelActivity.java b/frameworks/base/packages/SystemUI/src/com/android/systemui/ridi/ReaderNotificationPanelActivity.java
