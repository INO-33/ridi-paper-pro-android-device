+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ */
+package com.android.systemui.ridi;
+
+import android.content.ContentResolver;
+import android.provider.Settings;
+
+/**
+ * Shared definition of the reader's system bar settings.
+ *
+ * The Settings app writes these keys and SystemUI reads them, so the names and
+ * the allowed range live in one place.
+ */
+public final class ReaderBarSettings {
+    /**
+     * How long the transient navigation bar stays visible after a swipe up, in
+     * seconds. Also accepted by the Settings app's picker.
+     */
+    public static final String NAV_BAR_TIMEOUT = "ridi_nav_bar_timeout_seconds";
+
+    public static final int DEFAULT_TIMEOUT_SECONDS = 3;
+    public static final int MIN_TIMEOUT_SECONDS = 1;
+    public static final int MAX_TIMEOUT_SECONDS = 15;
+
+    private ReaderBarSettings() {}
+
+    /** Returns the configured timeout in seconds, clamped to the valid range. */
+    public static int getTimeoutSeconds(ContentResolver resolver) {
+        final int value = Settings.System.getInt(resolver, NAV_BAR_TIMEOUT,
+                DEFAULT_TIMEOUT_SECONDS);
+        return clamp(value);
+    }
+
+    /** Returns the configured timeout in milliseconds. */
+    public static long getTimeoutMillis(ContentResolver resolver) {
+        return getTimeoutSeconds(resolver) * 1000L;
+    }
+
+    public static int clamp(int seconds) {
+        return Math.max(MIN_TIMEOUT_SECONDS, Math.min(MAX_TIMEOUT_SECONDS, seconds));
+    }
+}
