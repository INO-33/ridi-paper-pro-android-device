+/*
+ * Copyright (C) 2026 E70Q10 Android port
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ */
+package com.android.systemui.ridi;
+
+import android.graphics.Rect;
+import android.view.View;
+
+/** SystemUI-side use of the stock RIDI/Onyx packed E Ink View ABI. */
+public final class ReaderEinkRefresh {
+    public static final int REAGL_PARTIAL_NOWAIT =
+            View.EINK_WAVEFORM_MODE_REAGL
+                    | View.EINK_UPDATE_MODE_PARTIAL
+                    | View.EINK_WAIT_MODE_NOWAIT;
+
+    private ReaderEinkRefresh() {}
+
+    /**
+     * One clean GC16 pass over the whole panel, for still images.
+     *
+     * Deliberately NOWAIT. A WAIT request makes gralloc call
+     * MXCFB_WAIT_FOR_UPDATE_COMPLETE on SurfaceFlinger's own thread, which takes
+     * about a second on this panel and can hold the kernel's five second
+     * timeout. Blocking there while SystemUI is waiting for its draw to be
+     * acknowledged is enough to trigger an ANR.
+     *
+     * Waiting is also unnecessary: mxc_epdc_fb_blank() flushes every pending
+     * update before it powers the EPDC down, so a frame submitted before the
+     * blank still reaches the glass.
+     */
+    public static final int GC16_FULL_NOWAIT =
+            View.EINK_WAVEFORM_MODE_GC16
+                    | View.EINK_UPDATE_MODE_FULL
+                    | View.EINK_WAIT_MODE_NOWAIT;
+
+    /**
+     * Draws this view with a full GC16 refresh. Used for the suspend image,
+     * where residue would otherwise stay visible for as long as the device
+     * sleeps.
+     */
+    public static void fullRefresh(View view) {
+        if (view == null) {
+            return;
+        }
+        view.setDefaultUpdateMode(GC16_FULL_NOWAIT);
+        view.invalidate(GC16_FULL_NOWAIT);
+    }
+
+    /** Redraws just this view with a REAGL partial update. */
+    public static void invalidate(View view) {
+        if (view == null) {
+            return;
+        }
+        view.setDefaultUpdateMode(REAGL_PARTIAL_NOWAIT);
+        final int width = view.getWidth();
+        final int height = view.getHeight();
+        if (width > 0 && height > 0) {
+            view.invalidate(new Rect(0, 0, width, height), REAGL_PARTIAL_NOWAIT);
+        } else {
+            view.invalidate(REAGL_PARTIAL_NOWAIT);
+        }
+    }
+}
