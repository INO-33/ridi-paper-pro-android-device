+    <item android:maxLevel="28" android:drawable="@drawable/ridi_stat_sys_battery_c_28" />
+    <item android:maxLevel="43" android:drawable="@drawable/ridi_stat_sys_battery_c_43" />
+    <item android:maxLevel="57" android:drawable="@drawable/ridi_stat_sys_battery_c_57" />
