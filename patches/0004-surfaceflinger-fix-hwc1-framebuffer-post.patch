From: RIDI Paper Pro Android 8 bring-up
Subject: [PATCH] surfaceflinger: support HWC1 and GPU-less AGL rendering

Apply from the Android source root:

  patch -p1 < device/ridi/e70q10/patches/0004-surfaceflinger-fix-hwc1-framebuffer-post.patch

diff --git a/frameworks/native/opengl/libs/EGL/Loader.cpp b/frameworks/native/opengl/libs/EGL/Loader.cpp
index 23a2c23..1de6af6 100644
--- a/frameworks/native/opengl/libs/EGL/Loader.cpp
+++ b/frameworks/native/opengl/libs/EGL/Loader.cpp
@@ -345,6 +345,25 @@ static void* load_system_driver(const char* kind) {
                     break;
             }
 
+            // Software EGL implementations such as Mesa live in /system and
+            // cannot be loaded through the isolated vendor driver namespace.
+            // Honor ro.hardware.egl before scanning the directory; otherwise
+            // USE_SW_OPENGL may select libGLES_android.so first.
+            char driver[PROPERTY_VALUE_MAX];
+            if (property_get("ro.hardware.egl", driver, nullptr) > 0) {
+#if defined(__LP64__)
+                result = std::string("/system/lib64/egl/lib") + kind + "_" +
+                        driver + ".so";
+#else
+                result = std::string("/system/lib/egl/lib") + kind + "_" +
+                        driver + ".so";
+#endif
+                if (!access(result.c_str(), R_OK)) {
+                    return result;
+                }
+                result.clear();
+            }
+
             std::string pattern = std::string("lib") + kind;
             const char* const searchPaths[] = {
 #if defined(__LP64__)
@@ -434,12 +453,17 @@ static void* load_system_driver(const char* kind) {
     }
     const char* const driver_absolute_path = absolutePath.c_str();
 
-    // Try to load drivers from the 'sphal' namespace, if it exist. Fall back to
-    // the original routine when the namespace does not exist.
-    // See /system/core/rootdir/etc/ld.config.txt for the configuration of the
-    // sphal namespace.
-    void* dso = do_android_load_sphal_library(driver_absolute_path,
-                                              RTLD_NOW | RTLD_LOCAL);
+    // Vendor GPU drivers belong in the isolated sphal namespace.  The AGL
+    // software renderer is a system library and depends on system-private
+    // libraries such as libpixelflinger, so loading it through sphal fails in
+    // SurfaceFlinger even though the same file loads in zygote.
+    void* dso;
+    if (!strncmp(driver_absolute_path, "/system/", strlen("/system/"))) {
+        dso = dlopen(driver_absolute_path, RTLD_NOW | RTLD_LOCAL);
+    } else {
+        dso = do_android_load_sphal_library(driver_absolute_path,
+                                            RTLD_NOW | RTLD_LOCAL);
+    }
     if (dso == 0) {
         const char* err = dlerror();
         ALOGE("load_driver(%s): %s", driver_absolute_path, err ? err : "unknown");
diff --git a/frameworks/native/services/surfaceflinger/DisplayHardware/FramebufferSurface.cpp b/frameworks/native/services/surfaceflinger/DisplayHardware/FramebufferSurface.cpp
index 68d7a18..6b47b80 100644
--- a/frameworks/native/services/surfaceflinger/DisplayHardware/FramebufferSurface.cpp
+++ b/frameworks/native/services/surfaceflinger/DisplayHardware/FramebufferSurface.cpp
@@ -176,13 +176,17 @@ status_t FramebufferSurface::nextBuffer(sp<GraphicBuffer>& outBuffer, sp<Fence>&
 #else
     outBuffer = mCurrentBuffer;
 #endif
+#ifdef USE_HWC2
     status_t result =
             mHwc.setClientTarget(mDisplayType, outSlot, outFence, outBuffer, outDataspace);
     if (result != NO_ERROR) {
         ALOGE("error posting framebuffer: %d", result);
     }
-
     return result;
+#else
+    // HWC1 posts this buffer from onFrameAvailable() through fbPost().
+    return NO_ERROR;
+#endif
 }
 
 #ifndef USE_HWC2
