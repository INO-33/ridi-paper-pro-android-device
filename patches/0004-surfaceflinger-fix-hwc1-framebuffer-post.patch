     } else if (renderableType & EGL_OPENGL_ES_BIT) {
         contextClientVersion = 1;
@@ -413,12 +418,17 @@ static status_t selectEGLConfig(EGLDisplay display, EGLint format,
 EGLConfig RenderEngine::chooseEglConfig(EGLDisplay display, int format) {
     status_t err;
     EGLConfig config;
+    const bool forceGles1 = property_get_bool("ro.sf.force_gles1", false);
 
-    // First try to get an ES2 config
-    err = selectEGLConfig(display, format, EGL_OPENGL_ES2_BIT, &config);
