+struct epdc_region_t {
+    int left;
+    int top;
+    int width;
+    int height;
+};
+
+static bool find_changed_region(const unsigned char* frame,
+        const unsigned char* shadow, int width, int height, int stride,
+        int bytes_per_pixel, epdc_region_t* region)
+{
+    int min_x = width;
+    int min_y = height;
+    int max_x = -1;
+    int max_y = -1;
+    const size_t visible_row_bytes = width * bytes_per_pixel;
+
+    for (int y = 0; y < height; y++) {
+        const unsigned char* frame_row = frame + y * stride;
+        const unsigned char* shadow_row = shadow + y * stride;
+
+        if (memcmp(frame_row, shadow_row, visible_row_bytes) == 0)
+            continue;
+
+        int row_min_x = 0;
+        while (row_min_x < width &&
+                memcmp(frame_row + row_min_x * bytes_per_pixel,
+                       shadow_row + row_min_x * bytes_per_pixel,
+                       bytes_per_pixel) == 0) {
+            row_min_x++;
+        }
+
+        int row_max_x = width - 1;
+        while (row_max_x > row_min_x &&
+                memcmp(frame_row + row_max_x * bytes_per_pixel,
+                       shadow_row + row_max_x * bytes_per_pixel,
+                       bytes_per_pixel) == 0) {
+            row_max_x--;
+        }
+
+        if (row_min_x < min_x)
+            min_x = row_min_x;
+        if (row_max_x > max_x)
+            max_x = row_max_x;
+        if (y < min_y)
+            min_y = y;
+        max_y = y;
+    }
+
+    if (max_x < 0 || max_y < 0)
+        return false;
+
+    const int aligned_left = (min_x / EPDC_REGION_ALIGN) * EPDC_REGION_ALIGN;
+    const int aligned_top = (min_y / EPDC_REGION_ALIGN) * EPDC_REGION_ALIGN;
+    int aligned_right = ((max_x + 1 + EPDC_REGION_ALIGN - 1) /
+            EPDC_REGION_ALIGN) * EPDC_REGION_ALIGN;
+    int aligned_bottom = ((max_y + 1 + EPDC_REGION_ALIGN - 1) /
+            EPDC_REGION_ALIGN) * EPDC_REGION_ALIGN;
+
+    if (aligned_right > width)
+        aligned_right = width;
+    if (aligned_bottom > height)
+        aligned_bottom = height;
+
+    region->left = aligned_left;
+    region->top = aligned_top;
+    region->width = aligned_right - aligned_left;
+    region->height = aligned_bottom - aligned_top;
+    return true;
+}
+
+static void epdc_refresh(fb_context_t* ctx, private_module_t* m,
+        const unsigned char* frame)
+{
+    const int width = m->info.xres;
+    const int height = m->info.yres;
+    const int stride = m->finfo.line_length;
+    const int bytes_per_pixel = m->info.bits_per_pixel >> 3;
+    const size_t frame_size = stride * height;
+    epdc_region_t region = { 0, 0, width, height };
+    bool full_refresh = !ctx->epdc_shadow_valid;
+
+    ctx->epdc_post_count++;
+
+    if (bytes_per_pixel <= 0 || frame == NULL) {
+        ALOGE("E70Q10_EPDC invalid frame bpp=%d frame=%p",
+                bytes_per_pixel, frame);
+        return;
+    }
+
+    if (ctx->epdc_shadow_size != frame_size) {
+        free(ctx->epdc_shadow);
+        ctx->epdc_shadow = (unsigned char*)malloc(frame_size);
+        ctx->epdc_shadow_size = ctx->epdc_shadow ? frame_size : 0;
+        ctx->epdc_shadow_valid = false;
+        ctx->epdc_partial_updates = 0;
+        full_refresh = true;
+        if (ctx->epdc_shadow == NULL)
+            ALOGE("E70Q10_EPDC shadow allocation failed size=%zu", frame_size);
+    }
+
+    if (ctx->epdc_shadow_valid) {
+        if (!find_changed_region(frame, ctx->epdc_shadow, width, height,
+                stride, bytes_per_pixel, &region)) {
+            if (ctx->epdc_post_count <= 8 ||
+                    (ctx->epdc_post_count % 120) == 0) {
+                ALOGI("E70Q10_EPDC unchanged post=%lu skip",
+                        ctx->epdc_post_count);
+            }
+            return;
+        }
+
+        const unsigned long changed_area =
+                (unsigned long)region.width * region.height;
+        const unsigned long screen_area = (unsigned long)width * height;
+        if (changed_area * 100 >=
+                screen_area * EPDC_FULL_AREA_PERCENT ||
+                ctx->epdc_partial_updates >= EPDC_FULL_REFRESH_INTERVAL) {
+            region.left = 0;
+            region.top = 0;
+            region.width = width;
+            region.height = height;
+            full_refresh = true;
+        }
+    }
+
+    update_to_display(m, region.left, region.top, region.width, region.height,
+            full_refresh ? E70Q10_WAVEFORM_GC16 : WAVEFORM_MODE_AUTO,
+            full_refresh ? UPDATE_MODE_FULL : UPDATE_MODE_PARTIAL, 1, 0);
+
+    if (full_refresh)
+        ctx->epdc_partial_updates = 0;
+    else
+        ctx->epdc_partial_updates++;
+
+    if (ctx->epdc_shadow != NULL) {
+        memcpy(ctx->epdc_shadow, frame, frame_size);
+        ctx->epdc_shadow_valid = true;
+    }
+}
