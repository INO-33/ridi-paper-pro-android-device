@@ -193,11 +372,10 @@ static int fb_post(struct framebuffer_device_t* dev, buffer_handle_t buffer)
             return -errno;
         }
 
-        // Update EPDC with mode, and waveform setting
-        if (ctx->epdc_display == true)
-            update_to_display(m, 0, 0,
-                    m->info.xres, m->info.yres,
-                    WAVEFORM_MODE_AUTO, 1, 0);
+        if (ctx->epdc_display == true) {
+            epdc_refresh(ctx, m,
+                    reinterpret_cast<const unsigned char*>(hnd->base));
+        }
 
         m->currentBuffer = buffer;
         
@@ -219,7 +397,12 @@ static int fb_post(struct framebuffer_device_t* dev, buffer_handle_t buffer)
                 &buffer_vaddr);
 
         memcpy(fb_vaddr, buffer_vaddr, m->finfo.line_length * m->info.yres);
-        
+
+        if (ctx->epdc_display == true) {
+            epdc_refresh(ctx, m,
+                    reinterpret_cast<const unsigned char*>(buffer_vaddr));
+        }
+
         m->base.unlock(&m->base, buffer); 
         m->base.unlock(&m->base, m->framebuffer); 
     }
@@ -408,6 +591,7 @@ static int fb_close(struct hw_device_t *dev)
 {
     fb_context_t* ctx = (fb_context_t*)dev;
     if (ctx) {
+        free(ctx->epdc_shadow);
         free(ctx);
     }
     return 0;
diff --git a/vendor/nxp-opensource/imx/display/gralloc_v1/mapper.cpp b/vendor/nxp-opensource/imx/display/gralloc_v1/mapper.cpp
index 5a882e2..a606a64 100644
--- a/vendor/nxp-opensource/imx/display/gralloc_v1/mapper.cpp
+++ b/vendor/nxp-opensource/imx/display/gralloc_v1/mapper.cpp
@@ -31,6 +31,7 @@
 #include <hardware/gralloc.h>
 
 #include "gralloc_priv.h"
+#include "gr.h"
 
 
 /* desktop Linux needs a little help with gettid() */
@@ -43,12 +44,37 @@ pid_t gettid() { return syscall(__NR_gettid);}
 
 /*****************************************************************************/
 
-static int gralloc_map(gralloc_module_t const* /*module*/,
+static int gralloc_map(gralloc_module_t const* module,
         buffer_handle_t handle,
         void** vaddr)
 {
     private_handle_t* hnd = (private_handle_t*)handle;
-    if (!(hnd->flags & private_handle_t::PRIV_FLAGS_FRAMEBUFFER)) {
+    if (hnd->flags & private_handle_t::PRIV_FLAGS_FRAMEBUFFER) {
+        /*
+         * Android 8 allocates through the binderized allocator HAL.  The
+         * framebuffer handle therefore contains a base address from another
+         * process.  NXP's original gralloc assumed allocation happened in
+         * SurfaceFlinger and left that address untouched, causing PixelFlinger
+         * to write through a stale mapping.
+         *
+         * Map fb0 once in the importing process and rebuild the per-page base
+         * from the transport-safe offset.
+         */
+        private_module_t* m = (private_module_t*)module;
+        int err = 0;
+
+        pthread_mutex_lock(&m->lock);
+        if (!m->framebuffer)
+            err = mapFrameBufferLocked(m);
+        if (!err) {
+            hnd->base = uintptr_t(m->framebuffer->base) + hnd->offset;
+            hnd->pid = getpid();
+        }
+        pthread_mutex_unlock(&m->lock);
+
+        if (err)
+            return err;
+    } else {
         size_t size = hnd->size;
         void* mappedAddress = mmap(0, size,
                 PROT_READ|PROT_WRITE, MAP_SHARED, hnd->fd, 0);
diff --git a/vendor/nxp-opensource/imx/display/hwcomposer_v10/hwcomposer.cpp b/vendor/nxp-opensource/imx/display/hwcomposer_v10/hwcomposer.cpp
