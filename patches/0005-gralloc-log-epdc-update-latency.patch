@@ -266,6 +266,15 @@ static int hwc_device_open(const struct hw_module_t* module, const char* name,
 
     hwc_get_framebuffer_info(dev);
     hwc_get_display_type(dev);
+    /*
+     * EPDC does not provide a periodic scanout VSYNC like an LCD.  On the
+     * E70Q10, MXCFB_WAIT_FOR_VSYNC returns immediately, which makes the
+     * urgent-display VSyncThread spin and starve SurfaceFlinger's main loop.
+     * Use the existing timer-backed VSYNC implementation for EPDC instead.
+     */
+    if (dev->mDisplayType == HWC_DISPLAY_EPDC) {
+        dev->mVsyncThread->setFakeVSync(true);
+    }
 
     *device = &dev->device.common;
     ALOGI("<%s,%d>", __FUNCTION__, __LINE__);

