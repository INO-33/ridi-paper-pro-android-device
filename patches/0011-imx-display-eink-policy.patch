+/*
+ * HWC 1.1 does not carry the gralloc pixel format separately.  This legacy
+ * gralloc allocates tightly packed ashmem buffers and records their complete
+ * size in private_handle_t, so the row size gives us both the real stride and
+ * the bytes per pixel.  The framebuffer target is already an opaque,
+ * client-composited image; the fourth byte in RGBX_8888 is deliberately
+ * ignored rather than interpreted as alpha.
+ */
+static bool copy_framebuffer_target(const private_handle_t* sourceHandle,
+        const void* sourceAddress, uint16_t* destination,
+        int width, int height, int destinationStride,
+        int* sourceStrideOut, int* bytesPerPixelOut)
+{
+    if (sourceHandle == NULL || sourceAddress == NULL || height <= 0 ||
+        sourceHandle->size <= 0 ||
+        sourceHandle->size % height != 0) {
+        return false;
+    }
+
+    const int rowBytes = sourceHandle->size / height;
+    int bytesPerPixel = 0;
+    if (rowBytes >= width * 4 && rowBytes % 4 == 0)
+        bytesPerPixel = 4;
+    else if (rowBytes >= width * 2 && rowBytes % 2 == 0)
+        bytesPerPixel = 2;
+    else
+        return false;
+
+    const int sourceStride = rowBytes / bytesPerPixel;
+    const uint8_t* source = reinterpret_cast<const uint8_t*>(sourceAddress);
+    for (int y = 0; y < height; ++y) {
+        uint16_t* output = destination + y * destinationStride;
+        if (bytesPerPixel == 2) {
+            memcpy(output, source + y * rowBytes,
+                   width * sizeof(uint16_t));
+        } else {
+            const uint8_t* input = source + y * rowBytes;
+            for (int x = 0; x < width; ++x) {
+                const uint8_t* pixel = input + x * 4;
+                output[x] = pack565(pixel[0], pixel[1], pixel[2]);
+            }
+        }
+    }
+
+    if (sourceStrideOut != NULL)
+        *sourceStrideOut = sourceStride;
+    if (bytesPerPixelOut != NULL)
+        *bytesPerPixelOut = bytesPerPixel;
+    return true;
+}
+
+/*
+ * PxP rotates and converts the portrait app buffer into the landscape RGB565
+ * EPDC geometry. 1404 is not divisible by PxP v2's 8-pixel rotation block,
+ * so the hardware leaves the first four destination rows blank. Copy the
+ * contiguous result and repair only those four rows on the CPU.
+ */
+static bool compose_layer_pxp(PxpComposer* pxp,
+        const hwc_layer_1_t& layer, uint16_t* destination,
+        int destinationWidth, int destinationHeight, int destinationStride,
+        uint64_t* packNs, uint64_t* pxpNs, uint64_t* copyNs)
+{
+    if (pxp == NULL || layer.handle == NULL ||
+        layer.transform != HWC_TRANSFORM_ROT_270 ||
+        (layer.blending != HWC_BLENDING_NONE &&
+         layer.blending != HWC_BLENDING_PREMULT) ||
+        layer.planeAlpha != 255 ||
+        source_crop_left(layer) != 0 || source_crop_top(layer) != 0 ||
+        layer.displayFrame.left != 0 || layer.displayFrame.top != 0 ||
+        layer.displayFrame.right != destinationWidth ||
+        layer.displayFrame.bottom != destinationHeight) {
+        return false;
+    }
+
+    const int sourceWidth = source_crop_right(layer);
+    const int sourceHeight = source_crop_bottom(layer);
+    if (sourceWidth != destinationHeight ||
+        sourceHeight != destinationWidth) {
+        return false;
+    }
+    const private_handle_t* handle =
+            reinterpret_cast<const private_handle_t*>(layer.handle);
+    if (private_handle_t::validate(layer.handle) < 0 ||
+        handle->base == 0 || handle->size < sourceWidth * sourceHeight * 4 ||
+        pxp->input.size < static_cast<unsigned>(sourceWidth * sourceHeight * 4) ||
+        pxp->converted.size <
+                static_cast<unsigned>(destinationStride *
+                                      destinationHeight * 2)) {
+        return false;
+    }
+
+    const int sourceStride = handle->size /
+            (sourceHeight * static_cast<int>(sizeof(uint32_t)));
+    if (sourceStride < sourceWidth)
+        return false;
+
+    uint64_t start = monotonic_ns();
+    const uint8_t* source =
+            reinterpret_cast<const uint8_t*>(handle->base);
+    uint32_t* staging = reinterpret_cast<uint32_t*>(
+            static_cast<uintptr_t>(pxp->input.virt_uaddr));
+    for (int y = 0; y < sourceHeight; ++y) {
+        const uint8_t* row = source + y * sourceStride * 4;
+        uint32_t* output = staging + y * sourceWidth;
+        for (int x = 0; x < sourceWidth; ++x) {
+            const uint8_t* pixel = row + x * 4;
+            unsigned red = pixel[0];
+            unsigned green = pixel[1];
+            unsigned blue = pixel[2];
+            if (layer.blending == HWC_BLENDING_PREMULT) {
+                const unsigned white = 255 - pixel[3];
+                red = std::min(255U, red + white);
+                green = std::min(255U, green + white);
+                blue = std::min(255U, blue + white);
+            }
+            output[x] = (static_cast<uint32_t>(red) << 16) |
+                        (static_cast<uint32_t>(green) << 8) |
+                        blue;
+        }
+    }
+    *packNs = monotonic_ns() - start;
