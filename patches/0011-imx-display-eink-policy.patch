+    pxp_config_data config;
+    memset(&config, 0, sizeof(config));
+    config.s0_param.paddr = pxp->input.phys_addr;
+    config.s0_param.width = sourceWidth;
+    config.s0_param.height = sourceHeight;
+    config.s0_param.stride = sourceWidth;
+    config.s0_param.pixel_fmt = PXP_PIX_FMT_XRGB32;
+    config.s0_param.color_key = static_cast<unsigned>(-1);
+    config.proc_data.srect.width = sourceWidth;
+    config.proc_data.srect.height = sourceHeight;
+    config.out_param.paddr = pxp->converted.phys_addr;
+    config.out_param.width = destinationWidth;
+    config.out_param.height = destinationHeight;
+    config.out_param.stride = destinationStride;
+    config.out_param.pixel_fmt = PXP_PIX_FMT_RGB565;
+    config.proc_data.drect.width = destinationWidth;
+    config.proc_data.drect.height = destinationHeight;
+    config.proc_data.rotate = 270;
+
+    start = monotonic_ns();
+    if (pxp_config_channel(&pxp->channel, &config) != 0 ||
+        pxp_start_channel(&pxp->channel) != 0 ||
+        pxp_wait_for_completion(&pxp->channel, 10) != 0) {
+        ALOGE("E70Q10_PXP conversion failed errno=%d", errno);
+        return false;
+    }
+    *pxpNs = monotonic_ns() - start;
+
+    start = monotonic_ns();
+    const uint16_t* converted = reinterpret_cast<const uint16_t*>(
+            static_cast<uintptr_t>(pxp->converted.virt_uaddr));
+    memcpy(destination, converted,
+           destinationStride * destinationHeight * sizeof(uint16_t));
+    const int pxpMissingRows = 4;
+    for (int outputY = 0; outputY < pxpMissingRows; ++outputY) {
+        const int sourceX = sourceWidth - 1 - outputY;
+        uint16_t* output = destination + outputY * destinationStride;
+        for (int outputX = 0; outputX < destinationWidth; ++outputX) {
+            const uint8_t* pixel =
+                    source + (outputX * sourceStride + sourceX) * 4;
+            unsigned red = pixel[0];
+            unsigned green = pixel[1];
+            unsigned blue = pixel[2];
+            /*
+             * PxP's staging path flattens premultiplied transparency onto
+             * white. Apply the identical rule to the four CPU-repaired rows;
+             * otherwise transparent edge pixels become a black strip (the
+             * panel's right edge after ROT_270) and isolated black dots.
+             */
+            if (layer.blending == HWC_BLENDING_PREMULT) {
+                const unsigned white = 255 - pixel[3];
+                red = std::min(255U, red + white);
+                green = std::min(255U, green + white);
+                blue = std::min(255U, blue + white);
+            }
+            output[outputX] = pack565(red, green, blue);
+        }
+    }
+    *copyNs = monotonic_ns() - start;
+    return true;
+}
+
+static bool map_source_pixel(int transform, int sourceWidth, int sourceHeight,
+        int transformedX, int transformedY, int* sourceX, int* sourceY)
+{
+    switch (transform) {
+    case 0:
+        *sourceX = transformedX;
+        *sourceY = transformedY;
+        break;
+    case HWC_TRANSFORM_FLIP_H:
+        *sourceX = sourceWidth - 1 - transformedX;
+        *sourceY = transformedY;
+        break;
+    case HWC_TRANSFORM_FLIP_V:
+        *sourceX = transformedX;
+        *sourceY = sourceHeight - 1 - transformedY;
+        break;
+    case HWC_TRANSFORM_ROT_180:
+        *sourceX = sourceWidth - 1 - transformedX;
+        *sourceY = sourceHeight - 1 - transformedY;
+        break;
+    case HWC_TRANSFORM_ROT_90:
+        *sourceX = transformedY;
+        *sourceY = sourceHeight - 1 - transformedX;
+        break;
+    case HWC_TRANSFORM_FLIP_H | HWC_TRANSFORM_ROT_90:
+        *sourceX = transformedY;
+        *sourceY = transformedX;
+        break;
+    case HWC_TRANSFORM_FLIP_V | HWC_TRANSFORM_ROT_90:
+        *sourceX = sourceWidth - 1 - transformedY;
+        *sourceY = sourceHeight - 1 - transformedX;
+        break;
+    case HWC_TRANSFORM_ROT_270:
+        *sourceX = sourceWidth - 1 - transformedY;
+        *sourceY = transformedX;
+        break;
+    default:
+        return false;
+    }
+    return *sourceX >= 0 && *sourceX < sourceWidth &&
+           *sourceY >= 0 && *sourceY < sourceHeight;
+}
+
+/*
+ * The E70Q10 has no GLES2-capable GPU. Applications render their Views with
+ * CPU Skia into RGBA buffers. Compose the fullscreen buffers here so
+ * SurfaceFlinger does not need its GLES2 RenderEngine merely to reach the
+ * RGB565 EPDC framebuffer.
+ *
+ * This first bring-up path intentionally accepts only uncropped, four-byte
+ * buffers. Cropped wallpaper and video layers stay disabled until their
+ * allocation geometry can be supplied explicitly or handled by PxP.
+ */
+static bool compose_layer_software(const hwc_layer_1_t& layer,
+        uint16_t* destination, int destinationWidth, int destinationHeight,
+        int destinationStride)
+{
+    if (layer.handle == NULL) {
+        return false;
+    }
+
+    const int cropLeft = source_crop_left(layer);
+    const int cropTop = source_crop_top(layer);
+    const int sourceWidth = source_crop_right(layer) - cropLeft;
+    const int sourceHeight = source_crop_bottom(layer) - cropTop;
+    const int outputLeft = layer.displayFrame.left;
+    const int outputTop = layer.displayFrame.top;
+    const int outputRight = layer.displayFrame.right;
+    const int outputBottom = layer.displayFrame.bottom;
+    const int outputWidth = outputRight - outputLeft;
+    const int outputHeight = outputBottom - outputTop;
+    if (sourceWidth <= 0 || sourceHeight <= 0 ||
+        outputWidth <= 0 || outputHeight <= 0) {
+        return false;
+    }
+
+    const private_handle_t* handle =
+            reinterpret_cast<const private_handle_t*>(layer.handle);
+    if (private_handle_t::validate(layer.handle) < 0)
+        return false;
+
+    /*
+     * NXP gralloc does not store width/height in its native handle. Its
+     * Android View buffers use an unpadded 32-bit stride, so crop.right is
+     * the smallest valid source stride. Oversized wallpaper buffers are
+     * filtered separately and never enter this path.
+     */
+    const int sourceStride = source_crop_right(layer);
+    const size_t minimumBytes =
+            static_cast<size_t>(sourceStride) *
+            source_crop_bottom(layer) * sizeof(uint32_t);
+    if (handle->size < static_cast<int>(minimumBytes))
+        return false;
+
+    const uint8_t* source = reinterpret_cast<const uint8_t*>(handle->base);
+    if (source == NULL)
+        return false;
+
+    const bool rotated = (layer.transform & HWC_TRANSFORM_ROT_90) != 0;
+    const int transformedWidth = rotated ? sourceHeight : sourceWidth;
+    const int transformedHeight = rotated ? sourceWidth : sourceHeight;
+    const int clippedLeft = outputLeft < 0 ? 0 : outputLeft;
+    const int clippedTop = outputTop < 0 ? 0 : outputTop;
+    const int clippedRight =
+            outputRight > destinationWidth ? destinationWidth : outputRight;
+    const int clippedBottom =
+            outputBottom > destinationHeight ? destinationHeight : outputBottom;
+    const bool blend = layer.blending == HWC_BLENDING_PREMULT;
+    const unsigned planeAlpha = layer.planeAlpha;
+
+    for (int y = clippedTop; y < clippedBottom; ++y) {
+        const int transformedY =
+                static_cast<int>((static_cast<int64_t>(y - outputTop) *
+                                  transformedHeight) / outputHeight);
+        uint16_t* output = destination + y * destinationStride;
+        for (int x = clippedLeft; x < clippedRight; ++x) {
+            const int transformedX =
+                    static_cast<int>((static_cast<int64_t>(x - outputLeft) *
+                                      transformedWidth) / outputWidth);
+            int sourceX;
+            int sourceY;
+            if (!map_source_pixel(layer.transform, sourceWidth, sourceHeight,
+                                  transformedX, transformedY,
+                                  &sourceX, &sourceY)) {
+                continue;
+            }
+            sourceX += cropLeft;
+            sourceY += cropTop;
+
+            const uint8_t* pixel =
+                    source + (sourceY * sourceStride + sourceX) * 4;
+            unsigned alpha = blend ? pixel[3] : 255;
+            alpha = (alpha * planeAlpha + 127) / 255;
+            if (alpha == 0)
+                continue;
+
+            unsigned red = (pixel[0] * planeAlpha + 127) / 255;
+            unsigned green = (pixel[1] * planeAlpha + 127) / 255;
+            unsigned blue = (pixel[2] * planeAlpha + 127) / 255;
+            if (alpha < 255) {
+                const uint16_t old = output[x];
+                const unsigned inverse = 255 - alpha;
+                red += (expand5((old >> 11) & 0x1f) * inverse + 127) / 255;
+                green += (expand6((old >> 5) & 0x3f) * inverse + 127) / 255;
+                blue += (expand5(old & 0x1f) * inverse + 127) / 255;
+            }
+            output[x] = pack565(red > 255 ? 255 : red,
+                                green > 255 ? 255 : green,
+                                blue > 255 ? 255 : blue);
+        }
+    }
+    return true;
+}
+
+static bool can_compose_layer_software(const hwc_layer_1_t& layer)
+{
+    if (layer.compositionType == HWC_BACKGROUND)
+        return true;
+    if (layer.handle == NULL ||
+        source_crop_left(layer) < 0 || source_crop_top(layer) < 0 ||
+        source_crop_right(layer) <= 0 || source_crop_bottom(layer) <= 0 ||
+        source_crop_right(layer) <= source_crop_left(layer) ||
+        source_crop_bottom(layer) <= source_crop_top(layer) ||
+        layer.displayFrame.right <= layer.displayFrame.left ||
+        layer.displayFrame.bottom <= layer.displayFrame.top ||
+        (layer.blending != HWC_BLENDING_NONE &&
+         layer.blending != HWC_BLENDING_PREMULT) ||
+        layer.transform > HWC_TRANSFORM_ROT_270) {
+        return false;
+    }
+
+    const private_handle_t* handle =
+            reinterpret_cast<const private_handle_t*>(layer.handle);
+    if (private_handle_t::validate(layer.handle) < 0)
+        return false;
+
+    const size_t minimumBytes =
+            static_cast<size_t>(source_crop_right(layer)) *
+            source_crop_bottom(layer) * sizeof(uint32_t);
+    return handle->size >= static_cast<int>(minimumBytes);
+}
+
+/*
+ * The reader policy uses a plain white background and disables rotation
+ * screenshots/animations. Ignore the legacy oversized wallpaper crop and
+ * bufferless transition surfaces instead of forcing SurfaceFlinger's GLES2
+ * fallback for layers that intentionally contribute no reader UI.
+ */
+static bool can_ignore_reader_layer(const hwc_layer_1_t& layer,
+        int displayWidth, int displayHeight)
+{
+    if (layer.compositionType == HWC_BACKGROUND || layer.handle == NULL)
+        return true;
+
+    return (source_crop_left(layer) > 0 || source_crop_top(layer) > 0) &&
+           layer.displayFrame.left <= 0 && layer.displayFrame.top <= 0 &&
+           layer.displayFrame.right >= displayWidth &&
+           layer.displayFrame.bottom >= displayHeight &&
+           layer.blending == HWC_BLENDING_NONE && layer.planeAlpha == 255;
+}
+
+static void clamp_damage(DamageBounds* bounds,
+        int displayWidth, int displayHeight)
+{
+    if (bounds == NULL || !bounds->valid)
+        return;
+    bounds->left = std::max(0, bounds->left);
+    bounds->top = std::max(0, bounds->top);
+    bounds->right = std::min(displayWidth, bounds->right);
+    bounds->bottom = std::min(displayHeight, bounds->bottom);
+    if (bounds->right <= bounds->left || bounds->bottom <= bounds->top)
+        bounds->valid = false;
+}
+
+enum TargetDamageState {
+    TARGET_DAMAGE_ABSENT = 0,   /* no framebuffer target in this frame */
+    TARGET_DAMAGE_UNKNOWN,      /* target present, damage not described */
+    TARGET_DAMAGE_NONE,         /* target present, explicitly nothing changed */
+    TARGET_DAMAGE_VALID         /* usable rectangle */
+};
+
+/*
+ * Read SurfaceFlinger's display composition damage from the framebuffer target
+ * layer. HWComposer::setFramebufferTargetDamage() publishes it there.
+ *
+ * This is the accurate rectangle for E Ink. Producer damage from an individual
+ * layer only describes what that layer repainted; it cannot describe the area a
+ * layer stopped covering. SurfaceFlinger's region unions a layer's previous and
+ * current visible regions, so a moving object, a dismissed popup and a closed
+ * window all arrive with their old pixels included, which is exactly what a
+ * partial waveform needs in order not to leave residue.
+ *
+ * These rectangles are already in physical display coordinates: SurfaceFlinger
+ * applies the display's global transform (orientation 3 on this device) before
+ * handing the region over. No further mapping is allowed here.
+ */
+static TargetDamageState collect_target_damage(
+        const hwc_display_contents_1_t* primary,
+        int displayWidth, int displayHeight, DamageBounds* out)
+{
+    if (primary == NULL || out == NULL)
+        return TARGET_DAMAGE_ABSENT;
+
+    const hwc_layer_1_t* target = NULL;
+    for (size_t i = 0; i < primary->numHwLayers; ++i) {
+        if (primary->hwLayers[i].compositionType == HWC_FRAMEBUFFER_TARGET) {
+            target = &primary->hwLayers[i];
+            break;
+        }
+    }
+    if (target == NULL)
+        return TARGET_DAMAGE_ABSENT;
+
+    if (target->surfaceDamage.numRects == 0 ||
+        target->surfaceDamage.rects == NULL) {
+        return TARGET_DAMAGE_UNKNOWN;
+    }
+
+    DamageBounds bounds = {0, 0, 0, 0, false};
+    for (size_t i = 0; i < target->surfaceDamage.numRects; ++i) {
+        const hwc_rect_t& rect = target->surfaceDamage.rects[i];
+        union_damage(&bounds, rect.left, rect.top, rect.right, rect.bottom);
+    }
+    clamp_damage(&bounds, displayWidth, displayHeight);
+    if (!bounds.valid)
+        return TARGET_DAMAGE_NONE;
+
+    *out = bounds;
+    return TARGET_DAMAGE_VALID;
+}
+
+static DamageBounds collect_display_damage(
+        const hwc_display_contents_1_t* primary,
+        int displayWidth, int displayHeight)
+{
+    DamageBounds bounds = {0, 0, 0, 0, false};
+    if (primary == NULL)
+        return bounds;
+
+    for (size_t i = 0; i < primary->numHwLayers; ++i) {
+        const hwc_layer_1_t& layer = primary->hwLayers[i];
+        if (layer.compositionType == HWC_FRAMEBUFFER_TARGET ||
+            layer.compositionType == HWC_BACKGROUND ||
+            can_ignore_reader_layer(layer, displayWidth, displayHeight)) {
+            continue;
+        }
+
+        /*
+         * HWC 1.5 represents unknown/full-buffer damage with zero rects and
+         * unchanged content with one empty rect. Unknown damage must never be
+         * skipped on E Ink: update the complete displayed layer.
+         */
+        if (layer.surfaceDamage.numRects == 0 ||
+            layer.surfaceDamage.rects == NULL) {
+            union_damage(&bounds, layer.displayFrame.left,
+                    layer.displayFrame.top, layer.displayFrame.right,
+                    layer.displayFrame.bottom);
+            continue;
+        }
+
+        for (size_t rectIndex = 0;
+             rectIndex < layer.surfaceDamage.numRects; ++rectIndex) {
+            const hwc_rect_t& damage =
+                    layer.surfaceDamage.rects[rectIndex];
+            if (damage.right <= damage.left ||
+                damage.bottom <= damage.top) {
+                continue;
+            }
+            hwc_rect_t mapped;
+            if (!map_damage_to_display(layer, damage, &mapped)) {
+                union_damage(&bounds, layer.displayFrame.left,
+                        layer.displayFrame.top, layer.displayFrame.right,
+                        layer.displayFrame.bottom);
+                break;
+            }
+            union_damage(&bounds, mapped.left, mapped.top,
+                    mapped.right, mapped.bottom);
+        }
+    }
+
+    clamp_damage(&bounds, displayWidth, displayHeight);
+    return bounds;
+}
+
+static void set_epdc_damage(hwc_context_t* ctx,
+        const hwc_display_contents_1_t* primary)
+{
+    if (ctx == NULL || ctx->mFramebuffer == NULL ||
+        ctx->mFramebuffer->setUpdateRect == NULL) {
+        return;
+    }
+
+    const int displayWidth = ctx->mFramebuffer->width;
+    const int displayHeight = ctx->mFramebuffer->height;
+
+    DamageBounds damage = {0, 0, 0, 0, false};
+    const char* source = "target";
+    const TargetDamageState targetState = collect_target_damage(primary,
+            displayWidth, displayHeight, &damage);
+
+    switch (targetState) {
+    case TARGET_DAMAGE_VALID:
+        break;
+    case TARGET_DAMAGE_NONE:
+        /*
+         * SurfaceFlinger states that nothing changed. Leave the one-shot
+         * rectangle unset so the framebuffer HAL's shadow comparison decides,
+         * and never turn an idle frame into a full refresh.
+         */
+        if (sComposeSequence < 20) {
+            ALOGI("E70Q10_DAMAGE none post=%u", sComposeSequence);
+        }
+        return;
+    case TARGET_DAMAGE_UNKNOWN:
+        /*
+         * Damage was not described for this frame (first frames, forced
+         * repaint). Refresh the whole panel rather than guessing.
+         */
+        damage.left = 0;
+        damage.top = 0;
+        damage.right = displayWidth;
+        damage.bottom = displayHeight;
+        damage.valid = true;
+        source = "unknown";
+        break;
+    case TARGET_DAMAGE_ABSENT:
+    default:
+        /*
+         * No framebuffer target in this frame: the HWC is presenting its own
+         * composed canvas. Fall back to per-layer producer damage.
+         */
+        damage = collect_display_damage(primary, displayWidth, displayHeight);
+        source = "layer";
+        break;
+    }
+
+    if (!damage.valid)
+        return;
+
+    const int result = ctx->mFramebuffer->setUpdateRect(ctx->mFramebuffer,
+            damage.left, damage.top, damage.right - damage.left,
+            damage.bottom - damage.top);
+    if (sComposeSequence < 20 || (sComposeSequence % 120) == 0 ||
+            result != 0) {
+        ALOGI("E70Q10_DAMAGE src=%s physical=%d,%d %dx%d result=%d",
+                source, damage.left, damage.top,
+                damage.right - damage.left,
+                damage.bottom - damage.top, result);
+    }
+}
 
