+/*
+ * Convert one HWC 1.5 damage rectangle from the pre-transform source buffer
+ * into physical display coordinates. The E70Q10 normally uses ROT_270, but
+ * handle every non-combined HWC transform and conservatively reject unknown
+ * combinations so the caller can request a full layer update.
+ */
+static bool map_damage_to_display(const hwc_layer_1_t& layer,
+        const hwc_rect_t& damage, hwc_rect_t* output)
+{
+    const float cropLeft = layer.sourceCropf.left;
+    const float cropTop = layer.sourceCropf.top;
+    const float cropRight = layer.sourceCropf.right;
+    const float cropBottom = layer.sourceCropf.bottom;
+    const float sourceWidth = cropRight - cropLeft;
+    const float sourceHeight = cropBottom - cropTop;
+    if (output == NULL || sourceWidth <= 0 || sourceHeight <= 0)
+        return false;
+
+    float x0 = std::max(cropLeft, static_cast<float>(damage.left)) - cropLeft;
+    float y0 = std::max(cropTop, static_cast<float>(damage.top)) - cropTop;
+    float x1 = std::min(cropRight, static_cast<float>(damage.right)) - cropLeft;
+    float y1 = std::min(cropBottom, static_cast<float>(damage.bottom)) - cropTop;
+    if (x1 <= x0 || y1 <= y0)
+        return false;
+
+    float tx0;
+    float ty0;
+    float tx1;
+    float ty1;
+    float transformedWidth;
+    float transformedHeight;
+    switch (layer.transform) {
+    case 0:
+        tx0 = x0; ty0 = y0; tx1 = x1; ty1 = y1;
+        transformedWidth = sourceWidth;
+        transformedHeight = sourceHeight;
+        break;
+    case HWC_TRANSFORM_FLIP_H:
+        tx0 = sourceWidth - x1; ty0 = y0;
+        tx1 = sourceWidth - x0; ty1 = y1;
+        transformedWidth = sourceWidth;
+        transformedHeight = sourceHeight;
+        break;
+    case HWC_TRANSFORM_FLIP_V:
+        tx0 = x0; ty0 = sourceHeight - y1;
+        tx1 = x1; ty1 = sourceHeight - y0;
+        transformedWidth = sourceWidth;
+        transformedHeight = sourceHeight;
+        break;
+    case HWC_TRANSFORM_ROT_180:
+        tx0 = sourceWidth - x1; ty0 = sourceHeight - y1;
+        tx1 = sourceWidth - x0; ty1 = sourceHeight - y0;
+        transformedWidth = sourceWidth;
+        transformedHeight = sourceHeight;
+        break;
+    case HWC_TRANSFORM_ROT_90:
+        tx0 = sourceHeight - y1; ty0 = x0;
+        tx1 = sourceHeight - y0; ty1 = x1;
+        transformedWidth = sourceHeight;
+        transformedHeight = sourceWidth;
+        break;
+    case HWC_TRANSFORM_ROT_270:
+        tx0 = y0; ty0 = sourceWidth - x1;
+        tx1 = y1; ty1 = sourceWidth - x0;
+        transformedWidth = sourceHeight;
+        transformedHeight = sourceWidth;
+        break;
+    default:
+        return false;
+    }
+
+    const float displayWidth =
+            layer.displayFrame.right - layer.displayFrame.left;
+    const float displayHeight =
+            layer.displayFrame.bottom - layer.displayFrame.top;
+    if (displayWidth <= 0 || displayHeight <= 0)
+        return false;
+
+    output->left = static_cast<int>(floorf(layer.displayFrame.left +
+            tx0 * displayWidth / transformedWidth));
+    output->top = static_cast<int>(floorf(layer.displayFrame.top +
+            ty0 * displayHeight / transformedHeight));
+    output->right = static_cast<int>(ceilf(layer.displayFrame.left +
+            tx1 * displayWidth / transformedWidth));
+    output->bottom = static_cast<int>(ceilf(layer.displayFrame.top +
+            ty1 * displayHeight / transformedHeight));
+    return output->right > output->left && output->bottom > output->top;
+}
