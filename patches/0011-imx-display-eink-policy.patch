+static const int32_t EINK_POLICY_UNSPECIFIED = -1;
+static const int32_t EINK_WAVEFORM_MASK = 0x0f;
+static const int32_t EINK_AUTO_MODE_AUTOMATIC = 0x10;
+static const int32_t EINK_UPDATE_MODE_FULL = 0x20;
+static const int32_t EINK_WAIT_MODE_WAIT = 0x40;
+static const int32_t EINK_POLICY_VALID = 0x20000000;
+static const int32_t EINK_POLICY_DISABLE = 0x40000000;
+static const int32_t EINK_POLICY_SYSTEM_DEFAULT = 0x10000000;
