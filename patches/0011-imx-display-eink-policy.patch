+        ALOGI("E70Q10_POLICY packed=0x%08x wave=%d full=%d wait=%d disable=%d result=%d",
+                policy, policy & EINK_WAVEFORM_MASK,
+                (policy & EINK_UPDATE_MODE_FULL) != 0,
+                (policy & EINK_WAIT_MODE_WAIT) != 0,
+                (policy & EINK_POLICY_DISABLE) != 0, result);
