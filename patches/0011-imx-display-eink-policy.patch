+    case 0: return E70Q10_WAVEFORM_INIT;
+    case 1: return E70Q10_WAVEFORM_DU;
+    case 2: return E70Q10_WAVEFORM_GC16;
+    case 3: return E70Q10_WAVEFORM_GL16;   // GC4 fallback
+    case 4: return E70Q10_WAVEFORM_DU;     // ANIM
+    case 5: return E70Q10_WAVEFORM_A2;
+    case 6: return E70Q10_WAVEFORM_GL16;
+    case 7: return E70Q10_WAVEFORM_REAGL;
+    case 8: return E70Q10_WAVEFORM_REAGLD;
+    default: return E70Q10_WAVEFORM_AUTO;
