+    if (pxp_init() != 0) {
+        ALOGE("E70Q10_PXP initialization failed errno=%d", errno);
+        destroy_pxp(pxp);
+        return NULL;
+    }
+    pxp->initialized = true;
+    if (pxp_request_channel(&pxp->channel) != 0) {
+        ALOGE("E70Q10_PXP channel request failed errno=%d", errno);
+        destroy_pxp(pxp);
+        return NULL;
+    }
+    pxp->channelRequested = true;
+    pxp->input.size = sourceWidth * sourceHeight * sizeof(uint32_t);
+    pxp->input.mtype = MEMORY_TYPE_WC;
+    pxp->converted.size =
+            1888 * 1404 * sizeof(uint16_t);
+    pxp->converted.mtype = MEMORY_TYPE_UNCACHED;
+    if (pxp_get_mem(&pxp->input) != 0 ||
+        pxp_get_mem(&pxp->converted) != 0) {
+        ALOGE("E70Q10_PXP allocation failed errno=%d", errno);
+        destroy_pxp(pxp);
+        return NULL;
+    }
+    ALOGI("E70Q10_PXP ready input=%u output=%u",
+          pxp->input.size, pxp->converted.size);
+    return pxp;
+}
