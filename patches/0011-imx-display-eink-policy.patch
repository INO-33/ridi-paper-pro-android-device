+
+static uint64_t monotonic_ns()
+{
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    return static_cast<uint64_t>(now.tv_sec) * 1000000000ULL + now.tv_nsec;
+}
+
+static void destroy_pxp(PxpComposer* pxp)
+{
+    if (pxp == NULL)
+        return;
+    if (pxp->converted.phys_addr != 0)
+        pxp_put_mem(&pxp->converted);
+    if (pxp->input.phys_addr != 0)
+        pxp_put_mem(&pxp->input);
+    if (pxp->initialized) {
+        if (pxp->channelRequested)
+            pxp_release_channel(&pxp->channel);
+        pxp_uninit();
+    }
+    delete pxp;
+}
