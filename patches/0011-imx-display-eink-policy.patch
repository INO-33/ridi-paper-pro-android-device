+    for (size_t i = 0; i < primary->numHwLayers; ++i) {
+        int32_t layerPolicy = EINK_POLICY_UNSPECIFIED;
+        static_assert(sizeof(primary->hwLayers[i].reserved) >= sizeof(layerPolicy),
+                "hwc_layer_1_t reserved area is too small for E Ink policy");
+        memcpy(&layerPolicy, primary->hwLayers[i].reserved,
+                sizeof(layerPolicy));
+        policy = merge_eink_policy(policy, layerPolicy);
+    }
+    return policy;
+}
