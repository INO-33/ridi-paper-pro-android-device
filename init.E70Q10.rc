import /init.freescale.usb.rc

on early-init
    write /proc/sys/kernel/panic 10
    mount debugfs debugfs /sys/kernel/debug mode=0755
    wait /dev/block/mmcblk1p1
    mkdir /e70log 0770 root root
    mount vfat /dev/block/mmcblk1p1 /e70log rw noatime nosuid nodev
    mkdir /e70log/ridi-dev 0770 root root
    mkdir /e70log/ridi-dev/logs 0770 root root
    mkdir /e70log/ridi-dev/logs/android8-current 0770 root root
    write /e70log/ridi-dev/logs/android8-current/stage "early-init"
    copy /proc/cmdline /e70log/ridi-dev/logs/android8-current/cmdline.txt
    copy /proc/partitions /e70log/ridi-dev/logs/android8-current/partitions-early.txt

on fs
    # Only external SD partitions are present in this fstab.
    write /e70log/ridi-dev/logs/android8-current/stage "fs-before-mount-all"
    # The ramdisk contains empty /system and /vendor mount points. Android
    # init otherwise marks their rc directories as already scanned before the
    # external SD is mounted and skips the default late import.
    mount_all /fstab.E70Q10 /system/etc/init /vendor/etc/init
    write /e70log/ridi-dev/logs/android8-current/stage "fs-after-mount-all"
    copy /proc/mounts /e70log/ridi-dev/logs/android8-current/mounts-after-fs.txt

on post-fs
    write /e70log/ridi-dev/logs/android8-current/stage "post-fs"
    copy /proc/mounts /e70log/ridi-dev/logs/android8-current/mounts-post-fs.txt
    # The RTL8189FTV is an SDIO device. Load its vendor module before Android's
    # Wi-Fi services start so WifiNative can discover wlan0.
    insmod /vendor/lib/modules/8189fs.ko rtw_power_mgnt=0 rtw_enusbss=0
    setprop wlan.driver.status ok

on post-fs-data
    write /e70log/ridi-dev/logs/android8-current/stage "post-fs-data"
    copy /proc/mounts /e70log/ridi-dev/logs/android8-current/mounts-post-fs-data.txt
    mkdir /data/ridi 0770 system system
    mkdir /data/ridi/logs 0770 system system
    start e70q10_wifi_prepare

on boot
    write /e70log/ridi-dev/logs/android8-current/stage "boot"
    copy /proc/mounts /e70log/ridi-dev/logs/android8-current/mounts-boot.txt
    # i.MX6SoloLite has no 3D GPU. Match NXP's 6SL EVK policy and keep
    # application View rendering on the CPU-backed Skia Canvas path.
    setprop sys.viewroot.hw false
    setprop debug.egl.hw 0
    chown system system /sys/class/backlight/lm3630a_led/brightness
    chmod 0660 /sys/class/backlight/lm3630a_led/brightness
    chown system system /sys/class/backlight/lm3630a_led/color
    chmod 0660 /sys/class/backlight/lm3630a_led/color

on property:sys.boot_completed=1
    write /e70log/ridi-dev/logs/android8-current/stage "boot-completed"
    copy /proc/mounts /e70log/ridi-dev/logs/android8-current/mounts-boot-completed.txt
    write /dev/kmsg "E70Q10_ANDROID_BOOT_COMPLETED"
    start e70q10_eink_defaults

service e70q10_eink_defaults /system/bin/e70q10-eink-settings
    class late_start
    user system
    group system
    disabled
    oneshot

# Keep upgraded SD data partitions compatible without replacing saved Wi-Fi
# configuration. Clean data partitions receive the same setting from the
# system template when SupplicantManager creates its data file.
service e70q10_wifi_prepare /system/bin/sh /system/bin/e70q10-wifi-prepare
    class core
    user root
    group root wifi
    disabled
    oneshot

# Android's WifiService starts this disabled service through ctl.start after
# the legacy Wi-Fi HAL has brought up the RTL8189FTV module. This definition is
# intentionally the same nl80211/HIDL-capable invocation used by NXP's i.MX6SL
# Oreo reference device.
service wpa_supplicant /vendor/bin/hw/wpa_supplicant \
    -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf \
    -e/data/misc/wifi/entropy.bin -g@android:wpa_wlan0
    socket wpa_wlan0 dgram 660 wifi wifi
    class main
    disabled
    oneshot

# Set a 30 second hardware timeout and pet it every 10 seconds. If init or
# userspace wedges badly enough to stop watchdogd, the device returns to the
# stock boot path instead of remaining inaccessible.
service watchdogd /sbin/watchdogd 10 20
    class core
    user root
    group root
    seclabel u:r:watchdogd:s0
