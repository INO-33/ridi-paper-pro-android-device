<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Page keys must not suppress the on-screen keyboard. -->
    <bool name="def_show_ime_with_hard_keyboard">true</bool>
    <bool name="def_accelerometer_rotation">false</bool>
    <integer name="def_user_rotation">0</integer>
    <fraction name="def_window_animation_scale">0%</fraction>
    <fraction name="def_window_transition_scale">0%</fraction>
    <fraction name="def_animator_duration_scale">0%</fraction>
    <bool name="def_lockscreen_disabled">true</bool>
    <bool name="def_haptic_feedback">false</bool>
    <integer name="def_lockscreen_sounds_enabled">0</integer>
    <bool name="def_notification_pulse">false</bool>
    <integer name="def_heads_up_enabled">0</integer>
    <bool name="def_bluetooth_on">false</bool>
    <!-- Stock PAPER PRO ships with the 10-minute sleep timer selected. -->
    <integer name="def_screen_off_timeout">600000</integer>
    <!-- Hide the navigation bar for every window. PhoneWindowManager then shows
         it as a transient overlay when the user swipes up from the bottom edge,
         and SystemUI hides it again after the configured timeout. -->
    <string name="def_policy_control" translatable="false">immersive.navigation=*</string>
</resources>
