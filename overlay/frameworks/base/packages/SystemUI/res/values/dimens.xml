<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compact clock and percentage for the reader's 24dp status bar. -->
    <dimen name="status_bar_clock_size">16sp</dimen>

    <!-- Keep the battery percentage the same size as the clock. -->
    <dimen name="status_bar_battery_percent_size">@dimen/status_bar_clock_size</dimen>

    <!--
        The stock 4.4.2 battery artwork is a wide 51x24 bitmap, while the drawn
        Material battery it replaces is a narrow 9.5x14.5dp shape. Keeping the
        Material box made FIT_CENTER shrink the bitmap to its width, so the icon
        came out tiny. Keep approximately the artwork's 51:24 ratio while
        leaving a little more vertical breathing room in the 24dp status bar.
    -->
    <dimen name="status_bar_battery_icon_height">14dp</dimen>
    <dimen name="status_bar_battery_icon_width">30dp</dimen>

    <!-- Two dp of top padding moves centred contents down by one visual dp. -->
    <dimen name="status_bar_reader_top_inset">2dp</dimen>

    <!--
        Keep the navigation bar the same thickness as stock but make each key
        wider so the buttons are easier to hit with the transient overlay.
    -->
    <dimen name="navigation_key_width">104dp</dimen>
    <dimen name="navigation_extra_key_width">52dp</dimen>
    <dimen name="navigation_side_padding">24dp</dimen>
    <!-- PAPER's 30dp bar is smaller than AOSP's expanding 32dp dead zone.
         Every visible navigation key must accept the first intended tap. -->
    <dimen name="navigation_bar_deadzone_size">0dp</dimen>
    <dimen name="navigation_bar_deadzone_size_max">0dp</dimen>
</resources>
